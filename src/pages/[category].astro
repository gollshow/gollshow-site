---
/**
 * Painting / Conté & Pastel / Digital.
 *   1. a wash across the top with the room's name in ink
 *   2. "Latest": the first ten works of the list in /admin, at true proportions, drifting
 *      slowly sideways like film through a gate (drag, swipe, scroll; stops on hover)
 *   3. "All works": a tidy index, every work standing on the same baseline in equal cells,
 *      each developing in ink as it comes into view
 * S/M/L (set in /admin) changes a work's height in the Latest strip.
 * Any work opens the full-screen viewer. Calm ground behind the art.
 */
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Viewer from '../components/Viewer.astro';
import T from '../components/T.astro';
import { ART } from '../content.config';
import { getWorks, viewerData, type Work } from '../lib/art';
import { getSettings, navItems, type NavKey } from '../lib/site';

export function getStaticPaths() {
  return ART.map((category) => ({ params: { category } }));
}
const { category } = Astro.params as { category: (typeof ART)[number] };
const s = await getSettings();
const nav = navItems(s).find((n) => n.key === category)!;
const works = await getWorks(category);
const latest = works.slice(0, 10);
const seed = ART.indexOf(category) + 1;
const year = (w: Work) => w.meta.find((m) => /^\d{4}(\s*[–-]\s*\d{2,4})?$/.test(m));
---
<Base title={{ en: nav.en, ko: nav.ko }} current={category as NavKey} page="art">
  <Band en={nav.en} ko={nav.ko} seed={seed} short>
    <span><span data-l="en" lang="ko">{nav.ko}</span><span data-l="ko">{nav.en}</span></span>
    <span><T en={`${works.length} works`} ko={`${works.length}점`} /></span>
  </Band>

  {
    latest.length > 0 && (
      <section class="latest" aria-labelledby="latest-h">
        <div class="head">
          <h2 class="head__t" id="latest-h">
            <T en="Latest" ko="최근 작품" />
          </h2>
          <p class="head__hint">
            <T en="Drag or swipe sideways" ko="옆으로 끌거나 밀어 보세요" />
          </p>
        </div>
        <div
          class="strip"
          data-strip
          tabindex="0"
          aria-label={`${nav.en}, latest ${latest.length} works`}
          data-aria-en={`${nav.en}, latest ${latest.length} works`}
          data-aria-ko={`${nav.ko}, 최근 작품 ${latest.length}점`}
        >
          {['a', 'b'].map((set) => (
            <ul class="strip__set" data-set={set} aria-hidden={set === 'b' ? 'true' : undefined}>
              {latest.map((w, i) => (
                <li class="strip__item" style={`--a:${(w.w / w.h).toFixed(4)};--nh:${w.h};--k:${w.display === 'L' ? 1.14 : w.display === 'S' ? 0.78 : 1}`}>
                  <a class="strip__link" href={w.pic.large} data-view={i} tabindex={set === 'b' ? -1 : undefined} data-reveal="bleed">
                    <img
                      src={w.src}
                      srcset={w.srcset}
                      sizes="(max-width: 700px) 70vw, 36vw"
                      width={w.w}
                      height={w.h}
                      alt={set === 'b' ? '' : w.alt.en}
                      data-alt-en={set === 'b' ? undefined : w.alt.en}
                      data-alt-ko={set === 'b' ? undefined : w.alt.ko}
                      loading={i < 4 && set === 'a' ? 'eager' : 'lazy'}
                      decoding="async"
                      draggable="false"
                    />
                  </a>
                  <p class="strip__cap" aria-hidden={w.title ? undefined : 'true'}>
                    {w.title && <T en={w.title.en} ko={w.title.ko} />}
                    {w.title && year(w) && <span class="strip__y">{year(w)}</span>}
                  </p>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </section>
    )
  }

  <section class="index" aria-labelledby="all-h">
    <div class="head">
      <h2 class="head__t" id="all-h">
        <T en="All works" ko="전체 작품" />
      </h2>
      <p class="head__hint"><T en={`${works.length}`} ko={`${works.length}점`} /></p>
    </div>
    <ul class="grid">
      {
        works.map((w, i) => (
          <li class="tile">
            <a class="tile__frame" href={w.pic.large} data-view={i} data-reveal="bleed" style={`--d:${(i % 6) * 60}`}>
              <img
                src={w.src}
                srcset={w.srcset}
                sizes="(max-width: 700px) 46vw, 15vw"
                width={w.w}
                height={w.h}
                alt={w.alt.en}
                data-alt-en={w.alt.en}
                data-alt-ko={w.alt.ko}
                loading="lazy"
                decoding="async"
              />
            </a>
            {w.title ? (
              <p class="tile__cap">
                <T en={w.title.en} ko={w.title.ko} />
                {year(w) && <span class="tile__y">{year(w)}</span>}
              </p>
            ) : (
              <p class="tile__cap" aria-hidden="true" />
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <Viewer items={viewerData(works)} label={{ en: nav.en, ko: nav.ko }} />
</Base>

<script>
  import '../scripts/strip';
  import '../scripts/reveal';
</script>

<style>
  .head {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .head__t {
    font: 400 clamp(26px, 2.6vw, 38px) / 1 var(--f-display);
  }
  .head__hint {
    font: 400 13px/1.4 var(--f-nav);
    color: var(--ink-2);
  }

  /* 2. Latest: one long line of works, fading into the paper at both ends */
  .latest {
    margin-top: clamp(36px, 5vw, 72px);
    --sh: clamp(240px, 46vh, 520px);
  }
  .strip {
    margin-top: 22px;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 90%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 90%, transparent 100%);
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .strip.is-drag {
    cursor: grabbing;
    user-select: none;
  }
  .strip:focus-visible {
    outline-offset: -2px;
  }
  .strip__set {
    display: flex;
    align-items: flex-end;
    gap: clamp(22px, 3vw, 52px);
    padding-left: clamp(22px, 3vw, 52px);
    flex: none;
  }
  .strip__set[data-set='a'] {
    padding-left: var(--gutter);
  }
  .strip__item {
    flex: none;
    width: min(calc(var(--sh) * var(--k, 1) * var(--a)), 86vw);
  }
  .strip__link {
    display: block;
  }
  .strip__link img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--a);
    max-height: calc(var(--nh) * 1.5px);
    object-fit: contain;
    -webkit-user-drag: none;
  }
  .strip__cap {
    min-height: 1.2em;
    margin-top: 12px;
    display: flex;
    gap: 10px;
    align-items: baseline;
    font: 400 18px/1.2 var(--f-display);
  }
  .strip__y,
  .tile__y {
    font: 400 12px/1 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* 3. All works: equal cells, every work on the same baseline */
  .index {
    margin-top: clamp(72px, 9vw, 140px);
    padding-bottom: clamp(72px, 9vw, 140px);
  }
  .grid {
    width: 100%;
    max-width: var(--max);
    margin: 28px auto 0;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(140px, 12.4vw, 184px), 1fr));
    gap: clamp(30px, 3.6vw, 56px) clamp(18px, 2.2vw, 36px);
  }
  .tile {
    display: grid;
    grid-template-rows: 1fr auto;
    min-width: 0;
    transition: opacity 320ms ease;
  }
  .tile__frame {
    display: block;
    min-height: 0;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
  }
  .tile__frame {
    align-self: end;
  }
  .tile__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  .tile__frame:focus-visible {
    outline-offset: 5px;
  }
  .tile__cap {
    min-height: 1.4em;
    margin-top: 10px;
    display: flex;
    gap: 8px;
    align-items: baseline;
    justify-content: center;
    font: 400 15px/1.2 var(--f-display);
    text-align: center;
  }
  /* Pointing at one work quietens the others. */
  @media (hover: hover) and (pointer: fine) {
    .grid:has(.tile__frame:hover) .tile:not(:has(.tile__frame:hover)) {
      opacity: 0.38;
    }
  }
  @media (max-width: 700px) {
    .latest {
      --sh: clamp(200px, 46vh, 360px);
    }
    .head__hint {
      display: none;
    }
    .index .head__hint {
      display: block;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
