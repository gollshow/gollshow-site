---
/**
 * Painting / Conté & Pastel / Digital.
 *   1. a still watercolour shape with the room's name in ink (each room its own shape)
 *   2. a banner: the first ten works of the list in /admin, each enlarged to fill one
 *      wide frame, shown one at a time and sliding on calmly (src/scripts/slides.ts)
 *   3. "All works": a tidy index, every work standing on the same baseline in equal cells
 * Any work opens the full-screen viewer. Calm ground behind the art.
 */
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Viewer from '../components/Viewer.astro';
import T from '../components/T.astro';
import { ART } from '../content.config';
import { getWorks, viewerData, type Work } from '../lib/art';
import { getSettings, navItems, type NavKey } from '../lib/site';

export function getStaticPaths() {
  return ART.map((category) => ({ params: { category } }));
}
const { category } = Astro.params as { category: (typeof ART)[number] };
const s = await getSettings();
const nav = navItems(s).find((n) => n.key === category)!;
const works = await getWorks(category);
const latest = works.slice(0, 10);
const seed = ART.indexOf(category) + 1;
const SHAPE = { painting: 'stroke', 'conte-pastel': 'pool', digital: 'diagonal' } as const;
const FOCUS: Record<string, string> = { top: '50% 12%', center: '50% 50%', bottom: '50% 88%' };
const focusOf = (f?: string) => FOCUS[f ?? ''] ?? '50% 38%';
const year = (w: Work) => w.meta.find((m) => /^\d{4}(\s*[–-]\s*\d{2,4})?$/.test(m));
---
<Base title={{ en: nav.en, ko: nav.ko }} current={category as NavKey} page="art">
  <Band en={nav.en} ko={nav.ko} seed={seed} shape={SHAPE[category]} short>
    <span><span data-l="en" lang="ko">{nav.ko}</span><span data-l="ko">{nav.en}</span></span>
    <span><T en={`${works.length} works`} ko={`${works.length}점`} /></span>
  </Band>

  {
    latest.length > 0 && (
      <section
        class="feat"
        data-slides
        aria-roledescription="carousel"
        aria-label={`${nav.en}, latest works`}
        data-aria-en={`${nav.en}, latest works`}
        data-aria-ko={`${nav.ko}, 최근 작품`}
      >
        <div class="feat__frame" tabindex="0">
          <ul class="feat__track">
            {[...latest, latest[0]].map((w, k) => {
              const i = k % latest.length;
              const copy = k === latest.length;
              return (
                <li
                  class="feat__slide"
                  data-title-en={w.title?.en ?? ''}
                  data-title-ko={w.title?.ko ?? ''}
                  data-year={year(w) ?? ''}
                  aria-roledescription="slide"
                  aria-hidden={k === 0 ? 'false' : 'true'}
                >
                  <a class="feat__link" href={w.pic.large} data-view={i} tabindex={k === 0 ? 0 : -1}>
                    <img
                      src={w.src}
                      srcset={w.srcset}
                      sizes="(max-width: 700px) 100vw, min(92vw, 1368px)"
                      width={w.w}
                      height={w.h}
                      alt={copy ? '' : w.alt.en}
                      data-alt-en={copy ? undefined : w.alt.en}
                      data-alt-ko={copy ? undefined : w.alt.ko}
                      style={`object-position:${focusOf(w.focus)}`}
                      loading={k === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      draggable="false"
                    />
                  </a>
                </li>
              );
            })}
          </ul>
          <span class="feat__bar" aria-hidden="true"><i /></span>
        </div>
        <div class="feat__foot">
          <p class="feat__cap" aria-live="polite">
            <span data-l="en" data-cap-en>{latest[0].title?.en ?? ''}</span>
            <span data-l="ko" lang="ko" data-cap-ko>{latest[0].title?.ko ?? latest[0].title?.en ?? ''}</span>
            <span class="feat__y" data-cap-year>{year(latest[0]) ?? ''}</span>
          </p>
          <div class="feat__ctl">
            <button class="tbtn" type="button" data-prev><T en="Previous" ko="이전" /></button>
            <span class="feat__count" data-count>1 / {latest.length}</span>
            <button class="tbtn" type="button" data-next><T en="Next" ko="다음" /></button>
          </div>
        </div>
      </section>
    )
  }

  <section class="index" aria-labelledby="all-h">
    <div class="head">
      <h2 class="head__t" id="all-h">
        <T en="All works" ko="전체 작품" />
      </h2>
      <p class="head__hint"><T en={`${works.length}`} ko={`${works.length}점`} /></p>
    </div>
    <ul class="grid">
      {
        works.map((w, i) => (
          <li class="tile">
            <a class="tile__frame" href={w.pic.large} data-view={i} data-reveal="fade" style={`--d:${(i % 6) * 70}`}>
              <img
                src={w.src}
                srcset={w.srcset}
                sizes="(max-width: 700px) 46vw, 15vw"
                width={w.w}
                height={w.h}
                alt={w.alt.en}
                data-alt-en={w.alt.en}
                data-alt-ko={w.alt.ko}
                loading="lazy"
                decoding="async"
              />
            </a>
            {w.title ? (
              <p class="tile__cap">
                <T en={w.title.en} ko={w.title.ko} />
                {year(w) && <span class="tile__y">{year(w)}</span>}
              </p>
            ) : (
              <p class="tile__cap" aria-hidden="true" />
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <Viewer items={viewerData(works)} label={{ en: nav.en, ko: nav.ko }} />
</Base>

<script>
  import '../scripts/slides';
  import '../scripts/reveal';
</script>

<style>
  .head {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .head__t {
    font: 400 clamp(26px, 2.6vw, 38px) / 1 var(--f-display);
  }
  .head__hint {
    font: 400 13px/1.4 var(--f-nav);
    color: var(--ink-2);
  }

  /* 2. The banner: one work at a time, enlarged to fill a wide frame */
  .feat {
    width: 100%;
    max-width: var(--max);
    margin: clamp(28px, 4vw, 56px) auto 0;
    padding: 0 var(--gutter);
  }
  .feat__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    max-height: 74vh;
    width: 100%;
    background: color-mix(in srgb, var(--ink) 5%, var(--ground));
    touch-action: pan-y;
  }
  .feat__frame:focus-visible {
    outline-offset: 4px;
  }
  .feat__track {
    display: flex;
    height: 100%;
    transition: transform 1300ms cubic-bezier(0.65, 0.04, 0.25, 1);
  }
  .feat__slide {
    flex: 0 0 100%;
    height: 100%;
    overflow: hidden;
  }
  .feat__link {
    display: block;
    height: 100%;
    cursor: zoom-in;
  }
  .feat__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 9s linear;
    -webkit-user-drag: none;
    user-select: none;
  }
  .feat__slide.is-on .feat__link img {
    transform: scale(1.05);
  }
  /* a hairline that fills while the work is shown */
  .feat__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: color-mix(in srgb, var(--ground) 30%, transparent);
  }
  .feat__bar i {
    display: block;
    height: 100%;
    background: var(--ground);
    transform-origin: left;
    animation: feat-bar 6500ms linear both;
  }
  .feat.is-paused .feat__bar i {
    animation-play-state: paused;
  }
  @keyframes feat-bar {
    from {
      transform: scaleX(0);
    }
  }
  .feat__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 14px;
    min-height: 54px;
  }
  .feat__cap {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font: 400 clamp(20px, 1.8vw, 26px) / 1.2 var(--f-display);
    min-width: 0;
  }
  .feat__y {
    font: 400 13px/1 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .feat__ctl {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }
  .feat__count {
    font: 400 14px/1 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    min-width: 4.5ch;
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .feat__track,
    .feat__link img {
      transition: none;
    }
    .feat__slide.is-on .feat__link img {
      transform: none;
    }
    .feat__bar {
      display: none;
    }
  }

  /* 3. All works: equal cells, every work on the same baseline */
  .index {
    margin-top: clamp(72px, 9vw, 140px);
    padding-bottom: clamp(72px, 9vw, 140px);
  }
  .grid {
    width: 100%;
    max-width: var(--max);
    margin: 28px auto 0;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(140px, 12.4vw, 184px), 1fr));
    gap: clamp(30px, 3.6vw, 56px) clamp(18px, 2.2vw, 36px);
  }
  .tile {
    display: grid;
    grid-template-rows: 1fr auto;
    min-width: 0;
    transition: opacity 320ms ease;
  }
  .tile__frame {
    display: block;
    min-height: 0;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
  }
  .tile__frame {
    align-self: end;
  }
  .tile__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  .tile__frame:focus-visible {
    outline-offset: 5px;
  }
  .tile__cap {
    min-height: 1.4em;
    margin-top: 10px;
    display: flex;
    gap: 8px;
    align-items: baseline;
    justify-content: center;
    font: 400 15px/1.2 var(--f-display);
    text-align: center;
  }
  /* Pointing at one work quietens the others. */
  @media (hover: hover) and (pointer: fine) {
    .grid:has(.tile__frame:hover) .tile:not(:has(.tile__frame:hover)) {
      opacity: 0.38;
    }
  }
  @media (max-width: 700px) {
    .feat {
      padding: 0;
    }
    .feat__frame {
      aspect-ratio: 4 / 5;
      max-height: 70vh;
    }
    .feat__foot {
      padding: 12px 16px 0;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
