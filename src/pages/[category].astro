---
/**
 * Painting / Conté & Pastel / Digital.
 *   1. the room's name in ink over slowly flowing pigment (each room its own shape); the
 *      pigment takes the colours of the work that is open in the banner
 *   2. the banner: the ten latest works of the list in /admin standing side by side like
 *      the panels of a folding screen, one open at its own proportions (src/scripts/screen.ts)
 *   3. "All works": a tidy index, every work standing on the same baseline in equal cells
 * Any work opens the full-screen viewer, where its detail cuts follow below it.
 */
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Viewer from '../components/Viewer.astro';
import T from '../components/T.astro';
import { ART } from '../content.config';
import { getWorks, viewerData, type Work } from '../lib/art';
import { getSettings, navItems, type NavKey } from '../lib/site';

export function getStaticPaths() {
  return ART.map((category) => ({ params: { category } }));
}
const { category } = Astro.params as { category: (typeof ART)[number] };
const s = await getSettings();
const nav = navItems(s).find((n) => n.key === category)!;
const works = await getWorks(category);
const latest = works.slice(0, 10);
const seed = ART.indexOf(category) + 1;
const SHAPE = { painting: 'stroke', 'conte-pastel': 'pool', digital: 'diagonal' } as const;
const year = (w: Work) => w.meta.find((m) => /^\d{4}(\s*[–-]\s*\d{2,4})?$/.test(m));
// The screen is never taller than 1.5× the smallest of its works, so nothing is blown up.
const hmax = latest.length ? Math.round(Math.min(...latest.map((w) => w.h)) * 1.5) : 640;
---
<Base title={{ en: nav.en, ko: nav.ko }} current={category as NavKey} page="art">
  <Band en={nav.en} ko={nav.ko} seed={seed} shape={SHAPE[category]} short>
    <span><span data-l="en" lang="ko">{nav.ko}</span><span data-l="ko">{nav.en}</span></span>
    <span><T en={`${works.length} works`} ko={`${works.length}점`} /></span>
  </Band>

  {
    latest.length > 0 && (
      <section class="banner" data-screen aria-label={`${nav.en}, latest works`} data-aria-en={`${nav.en}, latest works`} data-aria-ko={`${nav.ko}, 최근 작품`}>
        <div class="screen" data-reveal="fade" style={`--hmax:${hmax}px`}>
          {latest.map((w, i) => (
            <button
              class:list={['pan', { 'is-open': i === 0 }]}
              type="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={w.alt.en}
              data-aria-en={w.alt.en}
              data-aria-ko={w.alt.ko}
              data-title-en={w.title?.en ?? ''}
              data-title-ko={w.title?.ko ?? ''}
              data-meta={w.meta.slice(0, 3).join(' · ')}
              data-pig={w.pigments.join(',')}
              style={`--ar:${(w.w / w.h).toFixed(4)}`}
            >
              <img src={w.src} srcset={w.srcset} sizes={`${Math.round((62 * w.w) / w.h)}vh`} alt="" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
            </button>
          ))}
        </div>
        <div class="kbar" data-reveal="fade" style="--d:500">
          <div class="kcap" aria-live="polite">
            <p class="kcap__t">
              <span data-l="en" data-cap-en>{latest[0].title?.en ?? ''}</span>
              <span data-l="ko" lang="ko" data-cap-ko>{latest[0].title?.ko ?? latest[0].title?.en ?? ''}</span>
            </p>
            <p class="kcap__m" data-cap-meta>{latest[0].meta.slice(0, 3).join(' · ')}</p>
          </div>
          <div class="kctl">
            <button class="tbtn" type="button" data-prev><T en="Previous" ko="이전" /></button>
            <span class="kctl__n" data-count>1 / {latest.length}</span>
            <button class="tbtn" type="button" data-next><T en="Next" ko="다음" /></button>
            <button class="tbtn" type="button" data-open><T en="Open the work" ko="작품 열기" /></button>
          </div>
        </div>
      </section>
    )
  }

  <section class="index" aria-labelledby="all-h">
    <div class="head">
      <h2 class="head__t" id="all-h">
        <T en="All works" ko="전체 작품" />
      </h2>
      <p class="head__hint"><T en={`${works.length}`} ko={`${works.length}점`} /></p>
    </div>
    <ul class="grid">
      {
        works.map((w, i) => (
          <li class="tile" style={`--c:${w.color}`}>
            <a class="tile__frame" href={w.pic.large} data-view={i} data-reveal="fade" style={`--d:${(i % 6) * 80}`}>
              <img
                src={w.src}
                srcset={w.srcset}
                sizes="(max-width: 700px) 46vw, 15vw"
                width={w.w}
                height={w.h}
                alt={w.alt.en}
                data-alt-en={w.alt.en}
                data-alt-ko={w.alt.ko}
                loading="lazy"
                decoding="async"
              />
            </a>
            {w.title ? (
              <p class="tile__cap">
                <T en={w.title.en} ko={w.title.ko} />
                {year(w) && <span class="tile__y">{year(w)}</span>}
              </p>
            ) : (
              <p class="tile__cap" aria-hidden="true" />
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <Viewer items={viewerData(works)} label={{ en: nav.en, ko: nav.ko }} />
</Base>

<script>
  import '../scripts/screen';
  import '../scripts/reveal';
</script>

<style>
  .head {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .head__t {
    font: 400 clamp(26px, 2.6vw, 38px) / 1 var(--f-display);
  }
  .head__hint {
    font: 400 13px/1.4 var(--f-nav);
    color: var(--ink-2);
  }

  /* 2. The banner: a folding screen of the latest works, edge to edge */
  .banner {
    margin-top: clamp(20px, 2.6vw, 36px);
  }
  .screen {
    --h: min(clamp(380px, 62vh, 640px), var(--hmax, 640px));
    --from: 1;
    display: flex;
    gap: 3px;
    width: 100%;
    height: var(--h);
    overflow: hidden;
  }
  .pan {
    position: relative;
    flex: 1 1 0px;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    cursor: pointer;
    transition:
      flex-grow 1.15s cubic-bezier(0.65, 0.04, 0.25, 1),
      flex-basis 1.15s cubic-bezier(0.65, 0.04, 0.25, 1);
  }
  /* the picture keeps its place and size; the panel only uncovers more or less of it */
  .pan img {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: none;
    aspect-ratio: var(--ar);
    transform: translateX(-50%);
    filter: brightness(0.46) saturate(0.7);
    transition: filter 1s ease;
    user-select: none;
    -webkit-user-drag: none;
  }
  .pan.is-open {
    flex: 0 0 min(calc(var(--h) * var(--ar)), 62vw);
    cursor: zoom-in;
  }
  .pan.is-open img {
    filter: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .pan:not(.is-open):hover img {
      filter: brightness(0.78) saturate(0.9);
    }
  }
  .pan:focus-visible {
    outline-offset: -3px;
  }
  .kbar {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 18px var(--gutter) 0;
    min-height: 96px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .kcap {
    min-width: 0;
    transition:
      opacity 450ms ease,
      filter 450ms ease;
  }
  .kcap.is-swap {
    opacity: 0;
    filter: blur(8px);
  }
  .kcap__t {
    font: 400 clamp(30px, 3.6vw, 56px) / 1.05 var(--f-display);
    letter-spacing: -0.01em;
    min-height: 1.05em;
  }
  .kcap__m {
    margin-top: 8px;
    min-height: 1.5em;
    font: 400 14px/1.5 var(--f-ui);
    color: var(--ink-2);
  }
  .kctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
  }
  .kctl__n {
    font: 400 14px/1 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    min-width: 5ch;
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .pan,
    .pan img,
    .kcap {
      transition: none;
    }
  }

  /* 3. All works: equal cells, every work on the same baseline */
  .index {
    overflow-x: clip;
    margin-top: clamp(72px, 9vw, 140px);
    padding-bottom: clamp(72px, 9vw, 140px);
  }
  .grid {
    width: 100%;
    max-width: var(--max);
    margin: 28px auto 0;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(140px, 12.4vw, 184px), 1fr));
    gap: clamp(30px, 3.6vw, 56px) clamp(18px, 2.2vw, 36px);
  }
  .tile {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-width: 0;
    transition:
      opacity 600ms ease,
      filter 600ms ease;
  }
  /* the work's own colour, glowing faintly on the ground around it */
  .tile::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 4% -12% 10%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 46%, transparent), transparent);
    filter: blur(22px);
    opacity: 0;
    transition: opacity 700ms ease;
    pointer-events: none;
  }
  .tile__frame {
    display: block;
    align-self: end;
    min-height: 0;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
  }
  .tile__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  .tile__frame:focus-visible {
    outline-offset: 5px;
  }
  .tile__cap {
    min-height: 1.4em;
    margin-top: 10px;
    display: flex;
    gap: 8px;
    align-items: baseline;
    justify-content: center;
    font: 400 15px/1.2 var(--f-display);
    text-align: center;
  }
  .tile__y {
    font: 400 12px/1 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  /* Pointing at one work keeps it sharp; the others go softly out of focus. */
  @media (hover: hover) and (pointer: fine) {
    .grid:has(.tile__frame:hover) .tile:not(:has(.tile__frame:hover)) {
      opacity: 0.42;
      filter: blur(2.5px);
    }
    .tile:has(.tile__frame:hover)::before {
      opacity: 0.75;
    }
  }
  .tile:has(.tile__frame:focus-visible)::before {
    opacity: 0.75;
  }
  @media (max-width: 700px) {
    .screen {
      --h: min(clamp(320px, 52vh, 460px), var(--hmax, 460px));
    }
    .pan:nth-child(n + 6) {
      display: none;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
