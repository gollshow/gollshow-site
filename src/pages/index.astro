---
/**
 * Home: the pigment flow (no artwork on this first screen, the owner's rule). Scrolling
 * down dissolves the wordmark back into the pigment, which sinks into the ground, and the
 * rooms come into focus over it, one after another: Film first, then the art, music and
 * about. Pointing at a room keeps it sharp while the others soften, turns its name to a
 * pigment colour and floods the ground with that room's colours. A click or tap anywhere
 * lets one drop fall into the pigment.
 */
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { getEntry } from 'astro:content';
import { getSettings, navItems, publishedFilms, wordmarkOf } from '../lib/site';
import { getWorks } from '../lib/art';
import { pic, resolveImage, withBase } from '../lib/media';

const s = await getSettings();
const word = wordmarkOf(s);
const p = s.pigments;
const pig = [p.ultramarine, p.vermilion, p.viridian, p.ochre];
const nav = navItems(s);

// what each room shows when pointed at, and how much is in it
const films = await publishedFilms();
const filmMedia = films[0] ? resolveImage(films[0].data.still ?? films[0].data.stills[0]) : undefined;
const art = Object.fromEntries(
  await Promise.all(['painting', 'conte-pastel', 'digital'].map(async (c) => [c, await getWorks(c)] as const)),
);
const about = (await getEntry('pages', 'about'))?.data;
const music = (await getEntry('pages', 'music'))?.data;
const aboutMedia = resolveImage(about?.portrait);
const rooms = await Promise.all(
  nav.map(async (n) => {
    let img: Awaited<ReturnType<typeof pic>> | undefined;
    let meta: { en: string; ko: string } | undefined;
    if (n.key === 'film') {
      img = filmMedia ? await pic(filmMedia) : undefined;
      meta = { en: `${films.length} ${films.length === 1 ? 'film' : 'films'}`, ko: `${films.length}편` };
    } else if (n.key in art) {
      const w = art[n.key];
      img = w[0]?.pic;
      meta = { en: `${w.length} works`, ko: `${w.length}점` };
    } else if (n.key === 'music') {
      meta = { en: music?.name ?? 'gogolala', ko: music?.name ?? 'gogolala' };
    } else if (n.key === 'about') {
      img = aboutMedia ? await pic(aboutMedia) : undefined;
      meta = { en: about?.heading ?? 'goll', ko: about?.heading ?? 'goll' };
    }
    return { ...n, img, meta };
  }),
);
// the colours the ground takes while a room is pointed at
const ROOM_PAL: Record<string, string[]> = {
  film: ['#8E1218', '#2E7F86', '#4A0D16', '#E9B27A'],
  painting: ['#2AA7D6', '#F2B833', '#3E8C3A', '#E0457B'],
  'conte-pastel': ['#7B3F2A', '#A8324A', '#3F5B7A', '#D9B58A'],
  digital: ['#E0218A', '#22B14C', '#F2671E', '#2B6BE0'],
  music: ['#1C2B94', '#5B3FA8', '#0A6B5C', '#6EC4B7'],
  about: ['#DB3821', '#1C2B94', '#F2B833', '#0A6B5C'],
};
---
<Base home page="home">
  <section
    class="hero"
    data-hero
    data-word={word}
    data-pigments={pig.join(',')}
    style={`--p0:${pig[0]};--p1:${pig[1]};--p2:${pig[2]};--p3:${pig[3]}`}
  >
    <div class="hero__wash" aria-hidden="true"></div>
    <h1 class="hero__mark">{word}</h1>
    <canvas class="hero__cv" aria-hidden="true"></canvas>
    <button class="sound" type="button" data-sound aria-pressed="false" hidden>
      <span class="sound__dot" aria-hidden="true"></span>
      <span data-l="en">Sound</span><span data-l="ko" lang="ko">소리</span>
    </button>
    <a class="cue" href="#rooms" aria-label="Down to the rooms" data-aria-en="Down to the rooms" data-aria-ko="아래 목록으로"><span></span></a>
  </section>

  <section
    class="rooms"
    id="rooms"
    aria-label="Rooms"
    data-aria-en="Rooms"
    data-aria-ko="목록"
    style={`--p0:${pig[0]};--p1:${pig[1]};--p2:${pig[2]};--p3:${pig[3]}`}
  >
    {(s.roles_en || s.roles_ko) && <T as="p" class="rooms__roles" en={s.roles_en} ko={s.roles_ko} />}
    <ul class="rooms__list">
      {
        rooms.map((r, i) => (
          <li class="room" data-pal={(ROOM_PAL[r.key] ?? pig).join(',')} style={`--pc:var(--p${[1, 3, 2, 0][i % 4]})`}>
            <a class="room__a" href={withBase(r.path)}>
              <span class="room__name">
                <span data-l="en">{r.en}</span>
                <span data-l="ko" lang="ko">{r.ko}</span>
              </span>
              <span class="room__alt">
                <span data-l="en" lang="ko">{r.ko}</span>
                <span data-l="ko">{r.en}</span>
              </span>
              {r.meta && <T as="span" class="room__meta" en={r.meta.en} ko={r.meta.ko} />}
              {r.img && (
                <span class:list={['room__img', { 'room__img--wide': r.key === 'film' }]} aria-hidden="true">
                  <img src={r.img.src} srcset={r.img.srcset} sizes="72px" alt="" loading="lazy" decoding="async" />
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <footer class="rooms__foot">
      <span>© {new Date().getFullYear()} {s.site_title || 'gollshow'}</span>
      <span class="rooms__links">
        {s.instagram && <a href={s.instagram} rel="me noopener" target="_blank">Instagram</a>}
        {s.youtube && <a href={s.youtube} rel="me noopener" target="_blank">YouTube</a>}
        {s.email && <a href={`mailto:${s.email}`}>{s.email}</a>}
      </span>
    </footer>
  </section>
</Base>

<script>
  import '../scripts/hero';
  import '../scripts/sound';
  import '../scripts/rooms';
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    touch-action: pan-y;
  }
  /* the pigment stays behind the whole page and sinks as you scroll (src/scripts/hero.ts) */
  .hero__cv {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    z-index: 0;
  }
  .hero.is-gl .hero__cv {
    opacity: 1;
  }
  /* Static fallback (no JS, no WebGL): the ground, the wordmark in ink and a soft wash of the four pigments. */
  .hero__wash {
    position: absolute;
    inset: -12%;
    background:
      radial-gradient(34% 30% at 34% 40%, color-mix(in srgb, var(--p0) 70%, transparent), transparent 72%),
      radial-gradient(30% 34% at 66% 60%, color-mix(in srgb, var(--p1) 62%, transparent), transparent 72%),
      radial-gradient(26% 24% at 46% 66%, color-mix(in srgb, var(--p2) 60%, transparent), transparent 70%),
      radial-gradient(22% 20% at 60% 34%, color-mix(in srgb, var(--p3) 66%, transparent), transparent 70%);
    filter: blur(48px);
    opacity: 0.5;
  }
  .hero__mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-bottom: 2vh;
    font: 400 min(21.5vw, 34vh) / 1 var(--f-mark);
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
  }
  :global(.js) .hero:not(.is-static) .hero__wash,
  :global(.js) .hero:not(.is-static) .hero__mark {
    opacity: 0;
  }

  /* the optional sound: a quiet switch in the lower left, shown with the menu */
  .sound {
    position: absolute;
    z-index: 2;
    left: 28px;
    bottom: calc(22px + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font: 400 14px/1 var(--f-nav);
    letter-spacing: 0.01em;
    color: var(--ink-2);
    transition:
      opacity 900ms ease,
      color 200ms ease;
  }
  .sound:hover,
  .sound[aria-pressed='true'] {
    color: var(--ink);
  }
  .sound__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid currentColor;
    transition: background-color 300ms ease;
  }
  .sound[aria-pressed='true'] .sound__dot {
    background: currentColor;
  }

  /* a thin line at the foot of the screen: there is more below */
  .cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    width: 24px;
    height: 56px;
    margin-left: -12px;
    display: grid;
    justify-items: center;
    transition: opacity 900ms ease;
  }
  .cue span {
    position: relative;
    width: 1px;
    height: 100%;
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    overflow: hidden;
  }
  .cue span::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 40%;
    background: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cue span::after {
      animation: cue 2600ms cubic-bezier(0.65, 0.04, 0.25, 1) infinite;
    }
  }
  @keyframes cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(260%);
    }
  }
  :global(.js) .hero:not(.is-ready) .sound,
  :global(.js) .hero:not(.is-ready) .cue {
    opacity: 0;
    pointer-events: none;
  }

  /* the rooms, rising over the sunken pigment */
  .rooms {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(64px, 10vh, 120px) var(--gutter) 28px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .rooms__roles {
    font: 400 14px/1.5 var(--f-nav);
    color: var(--ink-2);
    margin-bottom: clamp(20px, 3vw, 36px);
  }
  .rooms__list {
    border-bottom: 1px solid var(--line);
  }
  .room__a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name meta' 'alt meta';
    align-items: end;
    column-gap: 24px;
    padding: clamp(14px, 1.8vw, 26px) 0 clamp(16px, 2vw, 28px);
  }
  /* the rule above each room draws in from the left */
  .room {
    position: relative;
  }
  .room::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--line);
    transform-origin: left;
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .room__name {
    grid-area: name;
    font: 400 clamp(52px, 8.4vw, 136px) / 0.9 var(--f-display);
    letter-spacing: -0.016em;
    justify-self: start;
    transition:
      opacity 1.5s ease,
      filter 1.9s cubic-bezier(0.2, 0.7, 0.2, 1),
      letter-spacing 2.1s cubic-bezier(0.2, 0.7, 0.2, 1),
      color 600ms ease,
      transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .room.is-settled .room__name {
    transition:
      opacity 700ms ease,
      filter 700ms ease,
      color 600ms ease,
      transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .room__alt,
  .room__meta,
  .room__img {
    transition:
      opacity 1.2s ease 0.9s,
      color 600ms ease;
  }
  /* before a room has come into focus (only when scripts run; without them everything is simply there) */
  :global(.js) .room:not(.is-go)::before {
    transform: scaleX(0);
  }
  :global(.js) .room:not(.is-go) .room__name {
    opacity: 0;
    filter: blur(22px);
    letter-spacing: 0.05em;
  }
  :global(.js) .room:not(.is-go) .room__alt,
  :global(.js) .room:not(.is-go) .room__meta,
  :global(.js) .room:not(.is-go) .room__img {
    opacity: 0;
  }
  /* pointing at one room keeps it sharp and lets the others go softly out of focus */
  @media (hover: hover) and (pointer: fine) {
    .rooms__list:has(.room__a:hover) .room.is-settled:not(:has(.room__a:hover)) .room__name {
      filter: blur(3px);
      opacity: 0.42;
    }
  }
  :global(html[data-lang='ko']) .room__name {
    font-size: clamp(42px, 6.6vw, 106px);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .room__alt {
    grid-area: alt;
    margin-top: 8px;
    font: 400 14px/1.3 var(--f-ui);
    color: var(--ink-2);
  }
  .room__meta {
    grid-area: meta;
    align-self: end;
    font: 400 14px/1.3 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    padding-bottom: 4px;
  }
  /* the small image is for phones only */
  .room__img {
    display: none;
  }
  /* pointing at a room: its name takes the room's pigment, lifted a little so it reads on the ground */
  .room__a:hover .room__name,
  .room__a:focus-visible .room__name {
    color: color-mix(in oklab, var(--pc) 70%, var(--ink));
    transform: translateX(6px);
  }
  .room__a:hover .room__meta,
  .room__a:focus-visible .room__meta {
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .room__name,
    .room.is-settled .room__name {
      transition: color 600ms ease;
    }
    .room::before,
    .room__alt,
    .room__meta,
    .room__img {
      transition: none;
    }
    .room__a:hover .room__name,
    .room__a:focus-visible .room__name {
      transform: none;
    }
  }
  .rooms__foot {
    margin-top: auto;
    padding-top: clamp(48px, 8vh, 96px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font: 400 13px/1.4 var(--f-nav);
    color: var(--ink-2);
  }
  .rooms__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .rooms__foot a:hover {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .sound {
      left: 16px;
    }
    .room__a {
      grid-template-columns: minmax(0, 1fr) 72px;
      grid-template-areas: 'name img' 'alt img' 'meta img';
      align-items: center;
      row-gap: 4px;
    }
    .room__meta {
      padding-bottom: 0;
    }
    .room__img {
      display: block;
      grid-area: img;
      width: 72px;
      height: 72px;
      overflow: hidden;
    }
    .room__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
