---
/**
 * The sound side of the film strip. The optical soundtrack runs down the left
 * edge: a thin bias line while it is silent, the real waveform of whatever is
 * playing when sound is on. Until tracks are uploaded, the old page's four
 * platform links are the room.
 */
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { getRooms, getPage, nameOf, isAudioFile, pad3 } from '../lib/works';
import { withBase } from '../lib/media';
import { UI } from '../lib/i18n';

const page = await getPage('music');
const room = (await getRooms()).find((r) => r.key === 'music')!;
const tracks = room.works
  .map((w) => ({ w, src: isAudioFile(w.data.audio) ? withBase(w.data.audio) : isAudioFile(w.data.link) ? w.data.link : undefined }))
  .filter((t) => t.src);
const name = page?.name ?? 'gogolala';
---
<Base title={`${page?.title ?? '음악'} ${page?.title_en ?? 'Music'}`} current="music" page="music" description={`${name} — goll, music`}>
  <section class="mu" aria-labelledby="mu-h">
    <canvas class="mu__track" data-soundtrack aria-hidden="true"></canvas>
    <div class="mu__body">
      <h1 id="mu-h" class="mu__name title">{name}</h1>

      {tracks.length > 0 ? (
        <ol class="mu__tracks">
          {tracks.map(({ w, src }) => (
            <li>
              <button class="mu__tr" type="button" data-play={JSON.stringify({ src, title: nameOf(w), title_en: nameOf(w, 'en'), href: withBase(w.href) })} aria-pressed="false">
                <span class="mu__no count ash">{pad3(w.no)}</span>
                <span class="mu__t"><T ko={nameOf(w)} en={nameOf(w, 'en')} /></span>
                <span class="mu__state ui"><span class="mu__p"><T t={UI.play} /></span><span class="mu__s"><T t={UI.pause} /></span></span>
              </button>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mu__note ash"><T ko="음원은 아직 이곳에 없습니다. 아래 플랫폼에서 들을 수 있습니다." en="No tracks are hosted here yet. Listen on these platforms." /></p>
      )}

      {page?.links && page.links.length > 0 && (
        <ul class="mu__links">
          {page.links.map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener me">{l.label ?? l.url}<span class="sr-only"> (<T t={UI.newWindow} />)</span></a></li>
          ))}
        </ul>
      )}

      <p class="mu__hint small ash">
        <button class="mu__on" type="button" data-sound-toggle aria-pressed="false"><span class="hd__off"><T t={UI.soundOn} /></span><span class="hd__on"><T t={UI.soundOff} /></span></button>
        <T ko="소리를 켜면 지금 들리는 소리가 왼쪽 사운드트랙에 새겨집니다." en="With sound on, what you hear is printed on the soundtrack at the left." />
      </p>
    </div>
  </section>
</Base>

<style>
  .mu { --tw: clamp(64px, 9vw, 132px); position: relative; min-height: 100svh; padding: calc(var(--header-h) + clamp(32px, 10vh, 120px)) var(--margin) 96px calc(var(--margin) + var(--tw) + clamp(28px, 5vw, 96px)); }
  .mu__track { position: fixed; left: var(--margin); top: var(--header-h); width: var(--tw); height: calc(100vh - var(--header-h)); background: var(--base); }
  .mu__name { color: var(--screen); }
  .mu__note { margin-top: clamp(28px, 5vh, 56px); max-width: 30em; }
  .mu__tracks { margin-top: clamp(28px, 5vh, 56px); display: grid; }
  .mu__tr { width: 100%; display: grid; grid-template-columns: 3.2em 1fr auto; align-items: baseline; gap: 12px; padding: 14px 0; text-align: left; border-bottom: 1px solid #1d1a16; }
  .mu__t { font-size: var(--t-head); font-weight: 200; line-height: 1.2; transition: color 160ms; }
  .mu__state { color: var(--ash); }
  .mu__s { display: none; }
  .mu__tr:global(.is-playing) .mu__s { display: inline; }
  .mu__tr:global(.is-playing) .mu__p { display: none; }
  .mu__tr:hover .mu__t, .mu__tr:global(.is-playing) .mu__t { color: var(--beam); }
  .mu__links { margin-top: clamp(28px, 5vh, 56px); display: grid; gap: 0; }
  .mu__links a { display: inline-block; padding: 4px 0; font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem); font-weight: 200; line-height: 1.2; letter-spacing: -0.015em; color: var(--ash); transition: color 160ms; }
  .mu__links a:hover, .mu__links a:focus-visible { color: var(--beam); }
  .mu__hint { margin-top: clamp(40px, 8vh, 96px); max-width: 34em; }
  .mu__on { color: var(--beam); border-bottom: 1px solid var(--dust); margin-right: 0.6em; min-height: 32px; }
  .mu__on .hd__on { display: none; }
  .mu__on[aria-pressed='true'] .hd__on { display: inline; }
  .mu__on[aria-pressed='true'] .hd__off { display: none; }
  @media (max-width: 760px) {
    .mu { --tw: 40px; padding-left: calc(var(--tw) + 22px); }
    .mu__track { left: 0; }
  }
</style>
