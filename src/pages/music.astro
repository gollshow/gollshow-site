---
/** Music: gogolala. Spotify as a lite embed (loads on click), every platform as a link. */
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Lite from '../components/Lite.astro';
import { getEntry } from 'astro:content';
import { getSettings, navItems, UI } from '../lib/site';
import { embedFor } from '../lib/embed';

const s = await getSettings();
const nav = navItems(s).find((n) => n.key === 'music')!;
const m = (await getEntry('pages', 'music'))?.data;
const links = m?.links ?? [];
const players = links.filter((l) => {
  const e = embedFor(l.url);
  return e && (e.kind === 'spotify' || (e.kind === 'youtube' && e.id) || e.kind === 'vimeo');
});
const host = (u: string) => u.replace(/^https?:\/\/(www\.|open\.|music\.)?/, '').replace(/\/$/, '');
---
<Base title={{ en: nav.en, ko: nav.ko }} current="music" page="music">
  <div class="page">
    <h1 class="page-title"><T en={nav.en} ko={nav.ko} /></h1>
    <div class="music">
      <div class="music__who">
        <p class="music__name">{m?.name ?? 'gogolala'}</p>
        {(m?.intro_en || m?.intro_ko) && <T block class="prose music__intro" en={m?.intro_en} ko={m?.intro_ko} />}
        <ul class="music__links">
          {
            links.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener">
                  <span class="music__label">{l.label ?? host(l.url)}</span>
                  <span class="music__host">{host(l.url)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="music__play">
        {
          players.map((l) => (
            <Lite url={l.url} label={{ en: `${UI.listen.en} on ${l.label ?? 'Spotify'}`, ko: `${l.label ?? 'Spotify'}에서 ${UI.listen.ko}` }} title={`${m?.name ?? 'gogolala'} — ${l.label}`} />
          ))
        }
      </div>
    </div>
  </div>
</Base>

<style>
  .music {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 48px clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .music__name {
    font: 400 clamp(44px, 6vw, 84px) / 1 var(--f-mark);
    margin-bottom: 28px;
  }
  .music__intro {
    max-width: 48ch;
    margin-bottom: 28px;
  }
  .music__who {
    min-width: 0;
  }
  .music__links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }
  .music__links a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font: 500 16px/1.3 var(--f-nav);
  }
  .music__host {
    font: 400 13px/1.3 var(--f-nav);
    color: var(--ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .music__links a:hover .music__label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  .music__play {
    display: grid;
    gap: 24px;
  }
  .music__play :global(.lite--spotify) {
    border-radius: 12px;
  }
  @media (max-width: 860px) {
    .music {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
