---
import Base from '../../layouts/Base.astro';
import RoomHead from '../../components/RoomHead.astro';
import RoomsList from '../../components/RoomsList.astro';
import Hang from '../../components/Hang.astro';
import T from '../../components/T.astro';
import { getRooms, getWorks, getSettings } from '../../lib/works';
import { UI } from '../../lib/i18n';

const s = await getSettings();
const rooms = await getRooms();
const works = (await getWorks()).filter((w) => w.data.category !== 'music');
---
<Base title={`${UI.works.ko} ${UI.works.en}`} current="works">
  <RoomHead ko={UI.works.ko} en={UI.works.en} count={works.length} unit={{ ko: '점', en: 'works' }} eyebrow={{ ko: s.intro ?? 'goll', en: s.intro_en ?? s.intro }} />
  <RoomsList rooms={rooms} heading={false} />
  {works.length > 0 && (
    <section class="all" aria-labelledby="all-h">
      <div class="frame"><h2 id="all-h" class="label muted all__h" data-reveal><T t={UI.all} /> · <T t={UI.index} /></h2></div>
      <Hang works={works} numbered={false} mode="index" />
    </section>
  )}
</Base>
<style>
  .all { margin-top: var(--room-gap); }
  .all__h { padding-bottom: 20px; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
</style>
