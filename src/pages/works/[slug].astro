---
/**
 * The permalink of a work: the same projection as the viewer, rendered
 * statically, with its caption, the process video when there is one, and the
 * previous / next frame of its reel.
 */
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Para from '../../components/Para.astro';
import Embed from '../../components/Embed.astro';
import { getWorks, caption, nameOf, isAudioFile, type Work } from '../../lib/works';
import { withBase } from '../../lib/media';
import { pic } from '../../lib/pic';
import { CATEGORY, UI } from '../../lib/i18n';
import { workLd } from '../../lib/seo';
import { videoSrc } from '../../lib/embed';
import { capHTML } from '../../scripts/caption';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((w) => ({ params: { slug: w.slug }, props: { slug: w.slug } }));
}

const all = await getWorks();
const work = all.find((w) => w.slug === Astro.props.slug)!;
const d = work.data;
const reel = all.filter((w) => w.data.category === d.category);
const i = reel.indexOf(work);
const prev = reel[i - 1];
const next = reel[i + 1];
const cat = CATEGORY[d.category];
const c = caption(work);
const main = work.image ? await pic(work.image) : undefined;
const more = await Promise.all(work.gallery.filter((g) => g.media && g.media !== work.image).map(async (g) => ({ p: await pic(g.media!), g })));
const audio = isAudioFile(d.audio) ? withBase(d.audio) : isAudioFile(d.link) ? d.link : undefined;
const external = d.link && !isAudioFile(d.link) ? d.link : undefined;
const name = nameOf(work);
const nameEn = nameOf(work, 'en');
const titleBi = name === nameEn ? name : `${name} ${nameEn}`;
const og = `/og/${work.slug}.jpg`;
const ogAbs = new URL(withBase(og)!, Astro.site).href;
const desc = [d.description ?? d.description_en, [c.title, c.year, c.sm].filter(Boolean).join(', '), `goll — ${cat.en} ${c.frame} / ${c.total}`].filter(Boolean).join(' — ').slice(0, 300);
const label = (w: Work) => nameOf(w);
// the projected image is bounded by width and by height: tell the browser its real size
const r = main ? (main.w / main.h).toFixed(3) : '1';
const sizes = `(max-width: 760px) min(92vw, calc(68svh * ${r})), min(70vw, calc((100svh - 260px) * ${r}))`;
const video = videoSrc(d.video);
---
<Base title={titleBi} description={desc} image={og} imageAlt={titleBi} kind="article" current={d.category} page="work" jsonld={workLd(work, Astro.site, ogAbs)}>
  <article class="wp">
    <div class="wp__screen">
      {main ? (
        <div class="wp__weave" style={`--r:${r}`}>
          {/* halation: a blurred copy, so the smallest file is enough */}
          <img class="wp__halo" src={main.small} alt="" width={main.w} height={main.h} aria-hidden="true" decoding="async" />
          <picture class="wp__pic">
            <source type="image/avif" srcset={main.avif} sizes={sizes} />
            <source type="image/webp" srcset={main.webp} sizes={sizes} />
            <img src={main.fallback} alt={name} width={main.w} height={main.h} fetchpriority="high" style={`background:${main.color} ${main.lqip} center/cover no-repeat`} />
          </picture>
        </div>
      ) : (
        <p class="wp__blank ash"><T ko="이미지 없음" en="No image" /></p>
      )}
      <div class="wp__vignette" aria-hidden="true"></div>
      <div class="wp__grainbox" aria-hidden="true"><div class="grain"></div></div>
    </div>

    <div class="wp__label">
      <p class="wp__count count ash"><a href={withBase(cat.path)}><T ko={cat.ko} en={cat.en} /></a> {c.frame} / {c.total}</p>
      {c.title ? <h1 class="wp__cap" set:html={capHTML(c, { frame: false })} /> : <h1 class="sr-only"><T ko={`${c.room_ko} ${c.frame}`} en={`${c.room_en} ${c.frame}`} /></h1>}
    </div>

    {(audio || external || video || d.description || d.description_en || more.length > 0) && (
      <div class="wp__more">
        {audio && (
          <button class="wp__play ui" type="button" data-play={JSON.stringify({ src: audio, title: name, title_en: nameEn, href: withBase(work.href) })}>
            <T t={UI.play} />
          </button>
        )}
        {video && (
          <section id="video" class="wp__video" aria-label={`${UI.process.ko} / ${UI.process.en}`}>
            <div class="wp__frame16">
              <iframe src={video} title={`${name} — ${UI.process.ko} (${UI.process.en})`} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
          </section>
        )}
        {external && <Embed url={external} title={name} />}
        <Para ko={d.description} en={d.description_en} class="wp__text" />
        {more.map(({ p, g }) => (
          <figure class="wp__fig">
            <picture>
              <source type="image/avif" srcset={p.avif} sizes="(max-width: 760px) 92vw, 60vw" />
              <source type="image/webp" srcset={p.webp} sizes="(max-width: 760px) 92vw, 60vw" />
              <img src={p.fallback} alt={name} width={p.w} height={p.h} loading="lazy" decoding="async" style={`background:${p.color}`} />
            </picture>
            {(g.caption || g.caption_en) && <figcaption class="small ash"><T ko={g.caption ?? g.caption_en} en={g.caption_en} /></figcaption>}
          </figure>
        ))}
      </div>
    )}

    <nav class="wp__nav" aria-label="Reel">
      {prev ? (
        <a class="wp__step" href={withBase(prev.href)} rel="prev"><span class="ui ash"><T t={UI.prev} /></span><span>{label(prev)}</span></a>
      ) : <span />}
      <a class="wp__step wp__step--wall" href={withBase('/')}><span class="ui ash"><T t={UI.toWall} /></span></a>
      {next ? (
        <a class="wp__step wp__step--next" href={withBase(next.href)} rel="next"><span class="ui ash"><T t={UI.next} /></span><span>{label(next)}</span></a>
      ) : <span />}
    </nav>
  </article>
</Base>

<style>
  .wp { padding: var(--header-h) var(--margin) 0; }
  .wp__screen { position: relative; height: calc(100svh - var(--header-h) - var(--cap-h, 136px)); min-height: 320px; display: grid; place-items: center; overflow: hidden; }
  .wp__label { min-height: var(--cap-h, 136px); padding-top: 10px; }
  .wp__weave { --maxh: calc(100svh - var(--header-h) - var(--cap-h, 136px) - 28px); width: 100%; display: grid; place-items: center; animation: weave 0.5s steps(1) infinite; }
  .wp__weave > *, .wp__pic img { grid-area: 1 / 1; }
  .wp__pic { display: contents; }
  /* the frame has its size before the file arrives: bounded by width and by height */
  .wp__pic img, .wp__halo { width: min(100%, calc(var(--maxh) * var(--r))); height: auto; aspect-ratio: var(--r); object-fit: contain; }
  .wp__halo { filter: blur(22px) saturate(1.6) sepia(0.35); opacity: 0.4; mix-blend-mode: screen; transform: scale(1.03); }
  .wp__vignette { position: absolute; inset: 0; background: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 55%, rgb(0 0 0 / 0.55) 100%); pointer-events: none; }
  .wp__grainbox { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .wp__grainbox .grain { opacity: 0.16; }
  .wp__count a:hover { color: var(--beam); }
  .wp { --cap-h: 164px; }
  .wp__cap { display: flex; flex-direction: column; font-weight: 400; font-size: var(--t-body); line-height: 1.45; margin-top: 2px; }
  .wp__cap :global(.c-title) { font-size: var(--t-head); font-weight: 200; line-height: 1.2; }
  .wp__cap :global(.c-year), .wp__cap :global(.c-sm) { color: var(--ash); }
  .wp__more { margin-top: clamp(48px, 10vh, 120px); display: grid; gap: clamp(40px, 8vh, 96px); max-width: 1100px; }
  .wp__play { justify-self: start; min-height: 44px; color: var(--beam); border-bottom: 1px solid var(--dust); }
  .wp__frame16 { position: relative; aspect-ratio: 16 / 9; background: #0b0a09; }
  .wp__frame16 iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #0b0a09; color-scheme: dark; }
  .wp__text { max-width: 34em; }
  .wp__fig img { max-height: 86svh; width: auto; }
  .wp__fig figcaption { margin-top: 10px; }
  .wp__nav { margin-top: clamp(64px, 14vh, 160px); padding: 18px 0 calc(40px + env(safe-area-inset-bottom)); border-top: 1px solid #1d1a16; display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: start; }
  .wp__step { display: grid; gap: 2px; min-height: 44px; }
  .wp__step:hover span { color: var(--beam); }
  .wp__step--next { text-align: right; }
  .wp__step--wall { text-align: center; }
  @media (max-width: 760px) {
    .wp__screen { height: auto; min-height: 0; padding: 24px 0 8px; }
    .wp__vignette { background: radial-gradient(ellipse 90% 85% at 50% 50%, transparent 70%, rgb(0 0 0 / 0.4) 100%); }
    .wp__weave { --maxh: 68svh; }
  }
</style>
