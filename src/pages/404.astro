---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Band from '../components/Band.astro';
import { UI } from '../lib/site';
import { withBase } from '../lib/media';
---
<Base title={{ en: '404', ko: '404' }} page="lost" noindex>
  <Band en="404" ko="404" seed={9} />
  <div class="page lost">
    <T as="p" class="lost__t" t={UI.lost} />
    <p><a class="text-link" href={withBase('/')}><T t={UI.backHome} /></a></p>
  </div>
</Base>
<style>
  .lost {
    min-height: 30vh;
    padding-top: 48px;
  }
  .lost__t {
    font: 400 clamp(26px, 3vw, 40px) / 1.2 var(--f-display);
    margin-bottom: 16px;
  }
</style>
