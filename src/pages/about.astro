---
/**
 * About, a director's page: the name over a slow pour of pigment; the statement (coming
 * into focus phrase by phrase) and bio
 * together with the 2002 poster beside them; film first (the three films, from the
 * Film collection), then painting and music; the record, newest first, grouped by year;
 * the KBS News Plaza clip (2003), played on the page; contact. Every text is edited in
 * /admin → 소개; the films come from /admin → 영화.
 */
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import T from '../components/T.astro';
import Lite from '../components/Lite.astro';
import { getEntry } from 'astro:content';
import { FORMAT, getSettings, navItems, publishedFilms, UI } from '../lib/site';
import { pic, resolveImage, withBase } from '../lib/media';

const s = await getSettings();
const nav = navItems(s);
const about = nav.find((n) => n.key === 'about')!;
const a = (await getEntry('pages', 'about'))?.data;
const pm = resolveImage(a?.portrait);
const portrait = pm ? await pic(pm) : undefined;
const capEn = a?.video_caption_en ?? a?.video_caption_ko ?? 'Video';
const capKo = a?.video_caption_ko ?? capEn;
const heading = a?.heading || 'goll';
const linkOf = (k?: string) => nav.find((n) => n.key === k);
const pg = s.pigments;
const pig = `--p0:${pg.ultramarine};--p1:${pg.vermilion};--p2:${pg.viridian};--p3:${pg.ochre}`;
const stEn = a?.statement_en ?? a?.statement_ko;
const stKo = a?.statement_ko ?? a?.statement_en;
// the statement in three phrases of about the same length, each coming into focus in turn
const phrases = (t: string, n = 3) => {
  const out: string[] = [];
  let cur = '';
  for (const w of t.split(/\s+/).filter(Boolean)) {
    cur = cur ? `${cur} ${w}` : w;
    if (out.length < n - 1 && cur.length >= t.length / n) {
      out.push(cur);
      cur = '';
    }
  }
  if (cur) out.push(cur);
  return out;
};

const practices = a?.practices ?? [];
const filmPractice = practices.find((p) => p.link === 'film');
const others = practices.filter((p) => p !== filmPractice);
const films = await Promise.all(
  (await publishedFilms()).slice(0, 3).map(async (f) => {
    const m = resolveImage(f.data.still ?? f.data.stills[0]);
    return { f, m, still: m ? await pic(m) : undefined };
  }),
);

// The record, grouped: consecutive entries with the same year share one label.
type Note = NonNullable<typeof a>['notes'][number];
const groups: { en?: string; ko?: string; items: Note[] }[] = [];
for (const n of a?.notes ?? []) {
  const last = groups[groups.length - 1];
  if (last && last.en === n.label_en && last.ko === n.label_ko) last.items.push(n);
  else groups.push({ en: n.label_en, ko: n.label_ko, items: [n] });
}
---
<Base title={{ en: about.en, ko: about.ko }} current="about" page="about">
  <Band en={heading} ko={heading} seed={7} shape="pour">
    {s.name_en && <span>{s.name_en}</span>}
    {(s.roles_en || s.roles_ko) && <T en={s.roles_en} ko={s.roles_ko} />}
  </Band>

  <div class="page page--band about" style={pig}>
    <!-- statement and bio, with the 2002 poster beside them -->
    <section class="intro">
      <div class="intro__text">
        {
          stEn && (
            <p class="statement">
              <span data-l={stKo !== stEn ? 'en' : undefined}>
                {phrases(stEn).map((c, i) => (
                  <>
                    <span data-reveal="fade" style={`--d:${150 + i * 380}`}>{c}</span>{' '}
                  </>
                ))}
              </span>
              {stKo && stKo !== stEn && (
                <span data-l="ko" lang="ko">
                  {phrases(stKo).map((c, i) => (
                    <>
                      <span data-reveal="fade" style={`--d:${150 + i * 380}`}>{c}</span>{' '}
                    </>
                  ))}
                </span>
              )}
            </p>
          )
        }
        {(a?.bio_en || a?.bio_ko) && (
          <div data-reveal="fade" style="--d:1100">
            <T block class="bio" en={a?.bio_en} ko={a?.bio_ko} />
          </div>
        )}
      </div>
      {
        portrait && (
          <figure class="poster" data-reveal="fade" style="--d:200">
            <img
              src={portrait.src}
              srcset={portrait.srcset}
              sizes="(max-width: 860px) 60vw, 24vw"
              width={portrait.w}
              height={portrait.h}
              alt={a?.portrait_caption_en ?? 'gollshow'}
              data-alt-en={a?.portrait_caption_en ?? 'gollshow'}
              data-alt-ko={a?.portrait_caption_ko ?? a?.portrait_caption_en ?? 'gollshow'}
              decoding="async"
            />
            {(a?.portrait_caption_en || a?.portrait_caption_ko) && (
              <T as="figcaption" class="meta" en={a?.portrait_caption_en} ko={a?.portrait_caption_ko} />
            )}
          </figure>
        )
      }
    </section>

    <!-- film first -->
    {
      (filmPractice || films.length > 0) && (
        <section class="lead" data-reveal="fade">
          <div class="lead__head">
            <h2 class="lead__t">
              <a href={withBase('/film/')}>
                <T en={filmPractice?.title_en ?? 'Film'} ko={filmPractice?.title_ko ?? '영화'} />
              </a>
            </h2>
            {filmPractice && (filmPractice.text_en || filmPractice.text_ko) && (
              <T as="p" class="lead__p" en={filmPractice.text_en} ko={filmPractice.text_ko} />
            )}
          </div>
          {films.length > 0 && (
            <ul class="reel">
              {films.map(({ f, still }, i) => {
                const d = f.data;
                const fmt = d.format ? FORMAT[d.format] : undefined;
                return (
                  <li data-reveal="fade" style={`--d:${i * 120}`}>
                    <a class="reel__a" href={withBase(`/film/${f.id}/`)}>
                      <span class="reel__img">
                        {still && <img src={still.src} srcset={still.srcset} sizes="(max-width: 860px) 92vw, 30vw" alt="" loading="lazy" decoding="async" style={`object-position:${d.focus ?? 'center'}`} />}
                      </span>
                      <span class="reel__t">
                        <span data-l="en">{d.title_en ?? d.title_ko}</span>
                        <span data-l="ko" lang="ko">{d.title_ko ?? d.title_en}</span>
                      </span>
                      <span class="reel__m">
                        {[d.year].filter(Boolean).join('')}
                        {fmt && (
                          <>
                            {d.year && ' · '}
                            <T t={fmt} />
                          </>
                        )}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      )
    }

    {
      others.length > 0 && (
        <section class="practices" aria-label="Practice">
          {others.map((p, i) => {
            const l = linkOf(p.link);
            const body = (
              <>
                <T as="h2" class="practice__t" en={p.title_en ?? p.title_ko} ko={p.title_ko ?? p.title_en} />
                {(p.text_en || p.text_ko) && <T as="p" class="practice__p" en={p.text_en} ko={p.text_ko} />}
              </>
            );
            return l ? (
              <a class="practice" href={withBase(l.path)} data-reveal="fade" style={`--d:${i * 120};--pc:var(--p${(i + 1) % 3})`}>
                {body}
              </a>
            ) : (
              <div class="practice" data-reveal="fade" style={`--d:${i * 120};--pc:var(--p${(i + 1) % 3})`}>
                {body}
              </div>
            );
          })}
        </section>
      )
    }

    <!-- the record, newest first -->
    {
      groups.length > 0 && (
        <section class="record">
          <h2 class="section-title">
            <T en="Record" ko="기록" />
          </h2>
          <ol class="record__list">
            {groups.map((g, i) => (
              <li class="record__row" data-reveal="fade" style={`--d:${Math.min(i, 6) * 60}`}>
                <T as="span" class="record__y" en={g.en ?? g.ko} ko={g.ko ?? g.en} />
                <ul class="record__items">
                  {g.items.map((n) => (
                    <li>
                      <T en={n.text_en ?? n.text_ko} ko={n.text_ko ?? n.text_en} />
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- press: the KBS clip -->
    {
      (a?.video_file || a?.video) && (
        <section class="press" data-reveal="fade">
          <div class="press__media">
            {a?.video_file ? (
              <video class="press__video" controls preload="none" playsinline poster={withBase(a.video_poster)} src={withBase(a.video_file)}>
                <a href={withBase(a.video_file)}>{capEn}</a>
              </video>
            ) : (
              <Lite url={a?.video} label={{ en: `${UI.play.en} — ${capEn}`, ko: `${UI.play.ko} — ${capKo}` }} title={capEn} />
            )}
          </div>
          <div class="press__text">
            <h2 class="section-title">
              <T en="Press" ko="보도" />
            </h2>
            <T as="p" class="press__cap" en={capEn} ko={capKo} />
          </div>
        </section>
      )
    }

    <section class="contact" data-reveal="fade">
      <h2 class="section-title"><T t={UI.contact} /></h2>
      {s.email && <a class="contact__mail" href={`mailto:${s.email}`}>{s.email}</a>}
      <ul class="contact__links">
        {s.instagram && <li><a class="text-link" href={s.instagram} target="_blank" rel="me noopener">Instagram</a></li>}
        {s.youtube && <li><a class="text-link" href={s.youtube} target="_blank" rel="me noopener">YouTube</a></li>}
        {s.links.map((l) => <li><a class="text-link" href={l.url} target="_blank" rel="noopener">{l.label ?? l.url}</a></li>)}
      </ul>
      {a?.address && <p class="contact__addr">{a.address}</p>}
    </section>
  </div>
</Base>

<script>
  import '../scripts/reveal';
</script>

<style>
  .page--band {
    padding-top: clamp(40px, 5.5vw, 88px);
  }
  .about {
    display: grid;
    gap: clamp(80px, 10vw, 160px);
  }
  .section-title {
    margin-bottom: 0;
  }

  /* statement and bio */
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(14px, 2vw, 32px);
    align-items: start;
  }
  .intro__text {
    grid-column: 1 / span 8;
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }
  .statement {
    font: 400 clamp(36px, 4.8vw, 76px) / 1.04 var(--f-display);
    letter-spacing: -0.012em;
    max-width: 18ch;
    text-wrap: balance;
  }
  :global(html[data-lang='ko']) .statement {
    font-size: clamp(28px, 3.6vw, 56px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 21ch;
  }
  .bio {
    max-width: 60ch;
    font-size: 18px;
    line-height: 1.72;
    margin-left: calc((100% / 8) * 1);
  }
  .bio :global(p + p) {
    margin-top: 1.1em;
  }
  .poster {
    grid-column: 10 / span 3;
    padding-top: 10px;
  }
  .poster img {
    width: 100%;
  }
  .poster figcaption {
    margin-top: 10px;
  }

  /* film first */
  .lead {
    display: grid;
    gap: clamp(28px, 3.4vw, 48px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .lead__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(14px, 2vw, 32px);
    align-items: end;
  }
  .lead__t {
    grid-column: 1 / span 5;
    font: 400 clamp(56px, 7vw, 116px) / 0.86 var(--f-display);
    letter-spacing: -0.016em;
  }
  .lead__t a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.1em;
    text-decoration-color: transparent;
    transition: text-decoration-color 300ms ease;
  }
  .lead__t a:hover {
    text-decoration-color: currentColor;
  }
  .lead__p {
    grid-column: 7 / span 6;
    max-width: 48ch;
    font-size: 18px;
    line-height: 1.6;
  }
  .reel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
  }
  .reel__a {
    display: grid;
    gap: 10px;
  }
  .reel__img {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 6%, var(--ground));
  }
  .reel__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .reel__a:hover .reel__img img {
    transform: scale(1.025);
  }
  .reel__t {
    font: 400 clamp(22px, 2vw, 30px) / 1.1 var(--f-display);
  }
  .reel__m {
    font: 400 13px/1.3 var(--f-nav);
    color: var(--ink-2);
  }

  /* painting and music */
  .practices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    margin-top: calc(clamp(80px, 10vw, 160px) * -0.5);
  }
  .practice {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px clamp(16px, 2.4vw, 40px) 30px 0;
  }
  .practice + .practice {
    padding-left: clamp(16px, 2.4vw, 40px);
    border-left: 1px solid var(--line);
  }
  .practice__t {
    font: 400 clamp(30px, 3vw, 44px) / 1 var(--f-display);
  }
  .practice__p {
    max-width: 40ch;
    color: var(--ink-2);
  }
  a.practice .practice__t {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    text-decoration-color: transparent;
    transition: text-decoration-color 200ms ease;
  }
  a.practice:hover .practice__t {
    text-decoration-color: currentColor;
  }
  .practice::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -8% -4% 10% -10%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--pc) 55%, transparent), transparent);
    filter: blur(26px);
    opacity: 0;
    transition: opacity 900ms ease;
    pointer-events: none;
  }
  a.practice:hover::before,
  a.practice:focus-visible::before {
    opacity: 0.7;
  }

  /* record, newest first */
  .record {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(14px, 2vw, 32px);
  }
  .record .section-title {
    grid-column: 1 / span 3;
    padding-top: 22px;
  }
  .record__list {
    grid-column: 4 / span 9;
    display: grid;
  }
  .record__row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 24px;
    padding: 20px 0 22px;
    border-top: 1px solid var(--line);
  }
  .record__row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .record__y {
    font: 400 clamp(26px, 2.4vw, 34px) / 1 var(--f-display);
    font-variant-numeric: tabular-nums;
  }
  .record__items {
    display: grid;
    gap: 10px;
    font-size: 17px;
    line-height: 1.5;
    padding-top: 4px;
  }

  /* press */
  .press {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(14px, 2vw, 32px);
    row-gap: 20px;
    align-items: end;
  }
  .press__media {
    grid-column: 1 / span 6;
  }
  .press__video {
    display: block;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 4 / 3;
    background: #000;
  }
  .press__text {
    grid-column: 8 / span 5;
    display: grid;
    gap: 14px;
    padding-bottom: 6px;
  }
  .press__cap {
    font: 400 clamp(22px, 2vw, 30px) / 1.25 var(--f-display);
    text-wrap: balance;
  }

  /* contact */
  .contact {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-bottom: 24px;
  }
  .contact__mail {
    font: 400 clamp(32px, 5vw, 76px) / 1 var(--f-display);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    text-decoration-color: var(--line);
  }
  .contact__mail:hover {
    text-decoration-color: currentColor;
  }
  .contact__links {
    display: flex;
    gap: 22px;
    font: 500 15px/1 var(--f-nav);
  }
  .contact__addr {
    margin-top: 14px;
    white-space: pre-line;
    color: var(--ink-2);
    font: 400 14px/1.6 var(--f-nav);
  }

  @media (max-width: 860px) {
    .intro,
    .lead__head,
    .record,
    .press {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }
    .intro__text,
    .poster,
    .lead__t,
    .lead__p,
    .record .section-title,
    .record__list,
    .press__media,
    .press__text {
      grid-column: 1;
    }
    .bio {
      margin-left: 0;
    }
    .poster {
      max-width: 300px;
    }
    .reel {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .practices {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }
    .practice,
    .practice + .practice {
      padding: 24px 0;
      border-left: 0;
    }
    .practice + .practice {
      border-top: 1px solid var(--line);
    }
    .record__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
  }
</style>
