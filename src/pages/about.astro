---
/** About: bio (EN/KR), the KBS clip as a lite embed, Instagram and contact. */
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Lite from '../components/Lite.astro';
import { getEntry } from 'astro:content';
import { getSettings, navItems, UI } from '../lib/site';
import { pic, resolveImage } from '../lib/media';

const s = await getSettings();
const nav = navItems(s).find((n) => n.key === 'about')!;
const a = (await getEntry('pages', 'about'))?.data;
const pm = resolveImage(a?.portrait);
const portrait = pm ? await pic(pm) : undefined;
const capEn = a?.video_caption_en ?? a?.video_caption_ko ?? 'Video';
const capKo = a?.video_caption_ko ?? capEn;
---
<Base title={{ en: nav.en, ko: nav.ko }} current="about" page="about">
  <div class="page">
    <h1 class="page-title"><T en={nav.en} ko={nav.ko} /></h1>
    <div class="about">
      <div class="about__text">
        {
          (s.name_en || s.name_ko) && (
            <p class="about__name">
              <T en={s.name_en ?? s.name_ko} ko={s.name_ko || s.name_en} />
            </p>
          )
        }
        {(s.roles_en || s.roles_ko) && <T as="p" class="about__roles" en={s.roles_en} ko={s.roles_ko} />}
        {(a?.bio_en || a?.bio_ko) && <T block class="about__bio" en={a?.bio_en} ko={a?.bio_ko} />}

        <section class="about__contact">
          <h2 class="section-title"><T t={UI.contact} /></h2>
          <ul>
            {s.email && <li><a class="text-link" href={`mailto:${s.email}`}>{s.email}</a></li>}
            {s.instagram && <li><a class="text-link" href={s.instagram} target="_blank" rel="me noopener">Instagram</a></li>}
            {s.youtube && <li><a class="text-link" href={s.youtube} target="_blank" rel="me noopener">YouTube</a></li>}
            {s.links.map((l) => <li><a class="text-link" href={l.url} target="_blank" rel="noopener">{l.label ?? l.url}</a></li>)}
          </ul>
        </section>
      </div>
      {
        portrait && (
          <figure class="about__img">
            <img src={portrait.src} srcset={portrait.srcset} sizes="(max-width: 860px) 100vw, 34vw" width={portrait.w} height={portrait.h} alt="gollshow, 2002" decoding="async" />
          </figure>
        )
      }
    </div>
    {
      a?.video && (
        <figure class="about__clip">
          <Lite url={a.video} label={{ en: `${UI.play.en} — ${capEn}`, ko: `${UI.play.ko} — ${capKo}` }} title={capEn} />
          <T as="figcaption" class="meta" en={capEn} ko={capKo} />
        </figure>
      )
    }
  </div>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 48px clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .about__name {
    font: 400 clamp(28px, 3vw, 40px) / 1.15 var(--f-display);
  }
  .about__roles {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .about__bio {
    margin-top: 32px;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.7;
    white-space: pre-line;
  }
  .about__bio :global(p + p) {
    margin-top: 1em;
  }
  .about__contact {
    margin-top: 48px;
  }
  .about__contact ul {
    display: grid;
    gap: 6px;
  }
  .about__img img {
    width: 100%;
    max-width: calc(var(--nw, 600) * 1.5px);
  }
  .about__clip {
    margin-top: clamp(64px, 9vw, 130px);
    max-width: 980px;
  }
  .about__clip figcaption {
    margin-top: 12px;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__img {
      max-width: 420px;
    }
  }
</style>
