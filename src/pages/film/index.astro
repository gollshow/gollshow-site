---
/**
 * Film: the centre of the work. Each film gets the full width of the screen in the
 * cinema ratio (2.39:1; 16:9 on phones) and comes into focus as it scrolls into view, then its titles, the facts (year, format, role),
 * the logline, its laurels, and the ways in. Newest first, in the order set in /admin.
 */
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Band from '../../components/Band.astro';
import Laurel from '../../components/Laurel.astro';
import { FORMAT, getSettings, laurelsOf, navItems, publishedFilms, runtimeOf, UI } from '../../lib/site';
import { pic, resolveImage, withBase } from '../../lib/media';
import { embedFor } from '../../lib/embed';

const s = await getSettings();
const pg = s.pigments;
const nav = navItems(s).find((n) => n.key === 'film')!;
const films = await Promise.all(
  (await publishedFilms()).map(async (f) => {
    const m = resolveImage(f.data.still ?? f.data.stills[0]);
    return { f, m, still: m ? await pic(m) : undefined, rt: runtimeOf(f.data.runtime), ...laurelsOf(f.data.festivals) };
  }),
);
const count = films.length;
---
<Base title={{ en: nav.en, ko: nav.ko }} current="film" page="film-list">
  <Band en={nav.en} ko={nav.ko} seed={4} shape="veil" short>
    <span><span data-l="en" lang="ko">{nav.ko}</span><span data-l="ko">{nav.en}</span></span>
    {count > 0 && <T en={`${count} ${count === 1 ? 'film' : 'films'}`} ko={`${count}편`} />}
  </Band>
  {
    films.length === 0 ? (
      <div class="page page--band">
        <T as="p" class="soon" t={UI.filmsSoon} />
      </div>
    ) : (
      <div class="films">
        {films.map(({ f, still, rt, laurels, lines }) => {
          const d = f.data;
          const en = d.title_en ?? d.title_ko ?? f.id;
          const ko = d.title_ko ?? d.title_en ?? f.id;
          const href = withBase(`/film/${f.id}/`);
          const fmt = d.format ? FORMAT[d.format] : undefined;
          const video = embedFor(d.trailer);
          return (
            <article class="film">
              {!d.published && <T as="p" class="draft" t={UI.draft} />}
              <a class="film__shot" href={href} aria-label={en} data-aria-en={en} data-aria-ko={ko} style={`--p0:${pg.ultramarine};--p1:${pg.vermilion};--p2:${pg.viridian};--p3:${pg.ochre}`}>
                <span class="film__pic" data-reveal="fade">
                  {still ? (
                    <img src={still.src} srcset={still.srcset} sizes="100vw" alt="" loading="lazy" decoding="async" style={`object-position:${d.focus ?? 'center'}`} />
                  ) : (
                    <span class="film__card" aria-hidden="true">
                      <span data-l="en">{en}</span>
                      <span data-l="ko" lang="ko">{ko}</span>
                    </span>
                  )}
                </span>
                {(d.logline_en || d.logline_ko) && (
                  <span class="film__sub" aria-hidden="true">
                    <span data-l={d.logline_ko && d.logline_ko !== d.logline_en ? 'en' : undefined}>{d.logline_en ?? d.logline_ko}</span>
                    {d.logline_ko && d.logline_ko !== d.logline_en && (
                      <span data-l="ko" lang="ko">
                        {d.logline_ko}
                      </span>
                    )}
                  </span>
                )}
              </a>
              <div class="film__body" data-reveal="fade" style="--d:350">
                <div class="film__names">
                  <h2 class="film__t">
                    <a href={href}>
                      <span data-l="en">{en}</span>
                      <span data-l="ko" lang="ko">{ko}</span>
                    </a>
                  </h2>
                  {d.title_ko && d.title_en && d.title_ko !== d.title_en && (
                    <p class="film__alt">
                      <span data-l="en" lang="ko">{d.title_ko}</span>
                      <span data-l="ko">{d.title_en}</span>
                    </p>
                  )}
                </div>
                <dl class="film__facts">
                  {d.year && (
                    <div>
                      <dt><T t={UI.year} /></dt>
                      <dd>{d.year}</dd>
                    </div>
                  )}
                  {fmt && (
                    <div>
                      <dt><T t={UI.format} /></dt>
                      <dd><T t={fmt} /></dd>
                    </div>
                  )}
                  {rt && (
                    <div>
                      <dt><T t={UI.runtime} /></dt>
                      <dd><T t={rt} /></dd>
                    </div>
                  )}
                  {(d.role_en || d.role_ko) && (
                    <div>
                      <dt><T t={UI.role} /></dt>
                      <dd><T en={d.role_en ?? d.role_ko} ko={d.role_ko ?? d.role_en} /></dd>
                    </div>
                  )}
                </dl>
                <div class="film__side">
                  {(d.logline_en || d.logline_ko) && <T as="p" class="film__log" en={d.logline_en} ko={d.logline_ko} />}
                  {laurels.length > 0 && (
                    <div class="film__laurels">
                      {laurels.map((l) => (
                        <Laurel size="small" name={l.name} award={l.award} year={l.year} />
                      ))}
                    </div>
                  )}
                  {lines.length > 0 && (
                    <ul class="film__lines">
                      {lines.map((x) => (
                        <li>
                          <T en={x.en} ko={x.ko} />
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="film__go">
                    <a class="text-link" href={href}><T t={UI.viewFilm} /></a>
                    {video && (
                      <a class="text-link" href={`${href}#watch`}>
                        <T t={d.full_film ? UI.watchFilm : UI.playTrailer} />
                      </a>
                    )}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )
  }
</Base>

<script>
  import '../../scripts/reveal';
</script>

<style>
  .page--band {
    padding-top: clamp(40px, 6vw, 96px);
  }
  .soon {
    font: 400 clamp(20px, 2.2vw, 26px) / 1.4 var(--f-display);
    color: var(--ink-2);
    min-height: 30vh;
  }
  .films {
    display: grid;
    gap: clamp(96px, 12vw, 200px);
    padding: clamp(40px, 6vw, 88px) 0 clamp(96px, 12vw, 180px);
  }
  .draft {
    max-width: var(--max);
    margin: 0 auto 10px;
    padding: 0 var(--gutter);
    font: 500 13px/1.4 var(--f-nav);
    color: var(--ink-2);
  }
  /* the screen: a dark 1.85 frame holding the 2.39 picture, the logline as a subtitle below it */
  .film__shot {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    width: 100%;
    aspect-ratio: 1.85;
    max-height: 86vh;
    overflow: hidden;
    background: #040405;
  }
  .film__pic {
    position: relative;
    isolation: isolate;
    display: block;
    width: 100%;
    aspect-ratio: 2.39;
    max-height: 100%;
    overflow: hidden;
    background: color-mix(in srgb, #0b0b0c 80%, var(--p0));
  }
  .film__pic:has(.film__card) {
    background: var(--ground);
  }
  .film__pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film__sub {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc((100% - 100vw / 2.39) / 2);
    display: grid;
    place-items: center;
    padding: 0 var(--gutter);
    color: #ece9e2;
    font: 400 clamp(14px, 1.15vw, 18px) / 1.45 var(--f-ui);
    text-align: center;
    text-wrap: balance;
  }
  .film__sub > span {
    max-width: 62ch;
  }
  /* the picture comes into focus as it scrolls into view, then drifts slowly closer; the subtitle follows */
  .film__pic {
    --from: 1.04;
  }
  @media (prefers-reduced-motion: no-preference) {
    .film__sub {
      transition: opacity 1s ease 1.5s;
    }
    :global(.js) .film__pic:not(.is-in) ~ .film__sub {
      opacity: 0;
    }
    .film__pic.is-in img {
      animation: film-push 24s ease-out 1.7s forwards;
    }
  }
  @keyframes film-push {
    to {
      transform: scale(1.06);
    }
  }
  .film__shot:focus-visible {
    outline-offset: -3px;
  }
  .film__card {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0 var(--gutter) clamp(18px, 3vw, 44px);
    font: 400 clamp(64px, 12vw, 200px) / 0.8 var(--f-display);
    color: var(--ink);
  }
  .film__card::before {
    content: '';
    position: absolute;
    inset: -10%;
    z-index: -1;
    background:
      radial-gradient(38% 62% at 22% 46%, color-mix(in srgb, var(--p0) 68%, transparent), transparent 72%),
      radial-gradient(30% 70% at 52% 58%, color-mix(in srgb, var(--p2) 58%, transparent), transparent 72%),
      radial-gradient(30% 60% at 76% 40%, color-mix(in srgb, var(--p1) 60%, transparent), transparent 72%);
    filter: blur(38px);
    opacity: 0.6;
  }
  /* the text under it, on the 12-column sheet */
  .film__body {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(22px, 2.6vw, 36px) var(--gutter) 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(14px, 2vw, 32px);
    row-gap: 24px;
    align-items: start;
  }
  .film__names {
    grid-column: 1 / span 5;
  }
  .film__t {
    font: 400 clamp(40px, 4.8vw, 76px) / 0.98 var(--f-display);
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .film__t a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    text-decoration-color: transparent;
    transition: text-decoration-color 300ms ease;
  }
  .film__t a:hover {
    text-decoration-color: currentColor;
  }
  .film__alt {
    margin-top: 12px;
    font: 400 18px/1.3 var(--f-ui);
    color: var(--ink-2);
  }
  .film__facts {
    grid-column: 6 / span 3;
    display: grid;
    gap: 12px;
    padding-top: 8px;
  }
  .film__facts dt {
    font: 400 12px/1.2 var(--f-nav);
    color: var(--ink-2);
  }
  .film__facts dd {
    font: 400 15px/1.4 var(--f-ui);
    margin-top: 2px;
  }
  .film__side {
    grid-column: 9 / span 4;
    display: grid;
    gap: 20px;
    padding-top: 8px;
  }
  .film__log {
    font-size: 17px;
    line-height: 1.55;
  }
  @media (min-width: 900px) {
    .film__log {
      display: none; /* it is the subtitle on the screen */
    }
  }
  .film__laurels {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .film__lines {
    font: 400 14px/1.5 var(--f-nav);
    color: var(--ink-2);
  }
  .film__go {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font: 500 15px/1.3 var(--f-nav);
  }
  @media (max-width: 960px) {
    .film__names {
      grid-column: 1 / -1;
    }
    .film__facts {
      grid-column: 1 / span 5;
    }
    .film__side {
      grid-column: 6 / -1;
    }
  }
  @media (max-width: 899px) {
    .film__sub {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .film__shot {
      aspect-ratio: 16 / 9;
    }
    .film__body {
      grid-template-columns: minmax(0, 1fr);
    }
    .film__names,
    .film__facts,
    .film__side {
      grid-column: 1;
    }
    .film__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
