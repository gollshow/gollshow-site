---
/** Film list: one film per row — a wide still (2.39:1), titles, year, role, runtime, logline. */
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Band from '../../components/Band.astro';
import { getSettings, navItems, publishedFilms, runtimeOf, UI } from '../../lib/site';
import { pic, resolveImage, withBase } from '../../lib/media';

const s = await getSettings();
const pg = s.pigments;
const nav = navItems(s).find((n) => n.key === 'film')!;
const films = await Promise.all(
  (await publishedFilms()).map(async (f) => {
    const m = resolveImage(f.data.still ?? f.data.stills[0]);
    return { f, still: m ? await pic(m) : undefined, rt: runtimeOf(f.data.runtime) };
  }),
);
---
<Base title={{ en: nav.en, ko: nav.ko }} current="film" page="film-list">
  <Band en={nav.en} ko={nav.ko} seed={4}>
    <span><span data-l="en" lang="ko">{nav.ko}</span><span data-l="ko">{nav.en}</span></span>
  </Band>
  <div class="page page--band">
    {
      films.length === 0 ? (
        <T as="p" class="soon" t={UI.filmsSoon} />
      ) : (
        <ul class="films">
          {films.map(({ f, still, rt }) => {
            const d = f.data;
            const en = d.title_en ?? d.title_ko ?? f.id;
            const ko = d.title_ko ?? d.title_en ?? f.id;
            const meta = (l: 'en' | 'ko') => [d.year, l === 'en' ? (d.role_en ?? d.role_ko) : (d.role_ko ?? d.role_en), rt?.[l]].filter(Boolean).join(' · ');
            return (
              <li class="film">
                <a class="film__link" href={withBase(`/film/${f.id}/`)}>
                  {!d.published && <T as="p" class="draft" t={UI.draft} />}
                  <div class:list={['film__still', { 'film__still--card': !still }]} style={`--p0:${pg.ultramarine};--p1:${pg.vermilion};--p2:${pg.viridian};--p3:${pg.ochre}`}>
                    {!still && (
                      <span class="film__card" aria-hidden="true">
                        <span data-l="en">{en}</span>
                        <span data-l="ko" lang="ko">{ko}</span>
                      </span>
                    )}
                    {still && (
                      <img
                        src={still.src}
                        srcset={still.srcset}
                        sizes="(max-width: 1480px) calc(100vw - 2 * var(--gutter)), 1368px"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        style={`object-position:${d.focus ?? 'center'}`}
                      />
                    )}
                  </div>
                  <div class="film__text">
                    <h2 class="film__title">
                      <span data-l="en">{en}{d.title_ko && d.title_ko !== en && <span class="film__alt" lang="ko">{d.title_ko}</span>}</span>
                      <span data-l="ko" lang="ko">{ko}{d.title_en && d.title_en !== ko && <span class="film__alt" lang="en">{d.title_en}</span>}</span>
                    </h2>
                    <p class="meta"><T en={meta('en')} ko={meta('ko')} /></p>
                    {(d.logline_en || d.logline_ko) && <T as="p" class="film__log" en={d.logline_en} ko={d.logline_ko} />}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .page--band {
    padding-top: clamp(40px, 6vw, 96px);
  }
  .film__still--card {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 0 clamp(16px, 3vw, 48px) clamp(14px, 2.4vw, 36px);
  }
  .film__still--card::before {
    content: '';
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(38% 62% at 22% 46%, color-mix(in srgb, var(--p0) 68%, transparent), transparent 72%),
      radial-gradient(30% 70% at 52% 58%, color-mix(in srgb, var(--p2) 58%, transparent), transparent 72%),
      radial-gradient(30% 60% at 76% 40%, color-mix(in srgb, var(--p1) 60%, transparent), transparent 72%),
      radial-gradient(22% 50% at 92% 66%, color-mix(in srgb, var(--p3) 64%, transparent), transparent 70%);
    filter: blur(38px);
    opacity: 0.6;
  }
  .film:nth-child(2n) .film__still--card::before {
    transform: scale(-1, 1);
  }
  .film:nth-child(3n) .film__still--card::before {
    transform: scale(-1, -1);
  }
  .film__card {
    position: relative;
    font: 400 clamp(64px, 13vw, 220px) / 0.8 var(--f-display);
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .soon {
    font: 400 clamp(20px, 2.2vw, 26px) / 1.4 var(--f-display);
    color: var(--ink-2);
    min-height: 30vh;
  }
  .films {
    display: grid;
    gap: clamp(64px, 9vw, 140px);
  }
  .film__link {
    display: block;
  }
  .film__still {
    aspect-ratio: 2.39;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 4%, var(--ground));
  }
  .film__still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px 48px;
    margin-top: 22px;
  }
  .film__title {
    font: 400 clamp(28px, 3.2vw, 44px) / 1.1 var(--f-display);
    grid-row: span 2;
  }
  .film__alt {
    display: block;
    margin-top: 8px;
    font: 400 16px/1.4 var(--f-ui);
    color: var(--ink-2);
  }
  .film__log {
    max-width: 52ch;
  }
  .film__link:hover .film__title > span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
  .draft {
    font: 500 13px/1.4 var(--f-nav);
    color: var(--ink-2);
    margin-bottom: 10px;
  }
  @media (max-width: 760px) {
    .film__text {
      grid-template-columns: minmax(0, 1fr);
    }
    .film__title {
      grid-row: auto;
    }
  }
</style>
