---
/** One film: trailer (lite embed) at the top, then the facts, synopsis, stills, credits, festivals, links. */
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Lite from '../../components/Lite.astro';
import Band from '../../components/Band.astro';
import Viewer from '../../components/Viewer.astro';
import { publishedFilms, runtimeOf, UI } from '../../lib/site';
import { pic, resolveImage, withBase } from '../../lib/media';
import { stillsToItems, viewerData } from '../../lib/art';
import { embedFor } from '../../lib/embed';

export async function getStaticPaths() {
  return (await publishedFilms()).map((f) => ({ params: { slug: f.id }, props: { f } }));
}
const { f } = Astro.props;
const d = f.data;
const en = d.title_en ?? d.title_ko ?? f.id;
const ko = d.title_ko ?? d.title_en ?? f.id;
const rt = runtimeOf(d.runtime);
const meta = (l: 'en' | 'ko') => [d.year, rt?.[l], l === 'en' ? (d.role_en ?? d.role_ko) : (d.role_ko ?? d.role_en)].filter(Boolean).join(' · ');
const stillRef = d.still ?? d.stills[0];
const sm = resolveImage(stillRef);
const still = sm ? await pic(sm) : undefined;
const stills = await stillsToItems(d.stills, { en: d.title_en, ko: d.title_ko });
const hasTrailer = !!embedFor(d.trailer);
const S = 1;
const bandHead = !hasTrailer && !still;
---
<Base title={{ en, ko }} current="film" page="film-page" description={d.logline_en ?? d.logline_ko} image={still?.large} noindex={!d.published}>
  {bandHead && <Band en={en} ko={ko} seed={11} />}
  <article class:list={['page film', { 'page--band': bandHead }]}>
    {!d.published && <T as="p" class="draft" t={UI.draft} />}
    <div class="film__head">
      {
        hasTrailer ? (
          <Lite
            url={d.trailer}
            poster={still ? { src: still.src, srcset: still.srcset, position: d.focus } : undefined}
            label={{ en: UI.playTrailer.en, ko: UI.playTrailer.ko }}
            title={`${en} — trailer`}
          />
        ) : (
          still && (
            <div class="film__still">
              <img src={still.src} srcset={still.srcset} sizes="100vw" alt="" style={`object-position:${d.focus ?? 'center'}`} />
            </div>
          )
        )
      }
    </div>

    <header class:list={['film__intro', { 'film__intro--solo': bandHead && !(d.title_ko && d.title_en && d.title_ko !== d.title_en) }]}>
      {
        bandHead ? (
          <p class="film__title film__title--alt">
            {d.title_ko && d.title_ko !== en && <span data-l="en" class="film__alt" lang="ko">{d.title_ko}</span>}
            {d.title_en && d.title_en !== ko && <span data-l="ko" class="film__alt" lang="en">{d.title_en}</span>}
          </p>
        ) : (
          <h1 class="film__title">
            <span data-l="en">{en}{d.title_ko && d.title_ko !== en && <span class="film__alt" lang="ko">{d.title_ko}</span>}</span>
            <span data-l="ko" lang="ko">{ko}{d.title_en && d.title_en !== ko && <span class="film__alt" lang="en">{d.title_en}</span>}</span>
          </h1>
        )
      }
      <div class="film__facts">
        <p class="meta"><T en={meta('en')} ko={meta('ko')} /></p>
        {(d.logline_en || d.logline_ko) && <T as="p" class="film__log" en={d.logline_en} ko={d.logline_ko} />}
      </div>
    </header>

    {
      (d.synopsis_en || d.synopsis_ko) && (
        <section class="film__sec">
          <h2 class="section-title"><T t={UI.synopsis} /></h2>
          <T block class="prose film__syn" en={d.synopsis_en} ko={d.synopsis_ko} />
        </section>
      )
    }

    {
      stills.length > 0 && (
        <section class="film__sec film__sec--wide">
          <h2 class="section-title"><T t={UI.stills} /></h2>
          <ul class="stills">
            {stills.map((st, i) => (
              <li style={`--a:${(st.w / st.h).toFixed(4)};--s:${S};--nw:${st.w}`}>
                <a href={st.pic.large} data-view={i}>
                  <img src={st.src} srcset={st.srcset} sizes="(max-width: 640px) 100vw, 40vw" width={st.w} height={st.h} alt={st.alt.en} data-alt-en={st.alt.en} data-alt-ko={st.alt.ko} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      d.credits.length > 0 && (
        <section class="film__sec">
          <h2 class="section-title"><T t={UI.credits} /></h2>
          <dl class="credits">
            {d.credits.map((c) => (
              <div>
                <dt><T en={c.role_en ?? c.role_ko} ko={c.role_ko ?? c.role_en} /></dt>
                <dd>{c.names.map((n) => <span>{n}</span>)}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      d.festivals.length > 0 && (
        <section class="film__sec">
          <h2 class="section-title"><T t={UI.festivals} /></h2>
          <ul class="fest">
            {d.festivals.map((x) => (
              <li>
                <span class="fest__y">{x.year}</span>
                <T en={x.text_en ?? x.text_ko} ko={x.text_ko ?? x.text_en} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      d.links.length > 0 && (
        <section class="film__sec">
          <h2 class="section-title"><T t={UI.links} /></h2>
          <ul class="links">
            {d.links.map((l) => (
              <li>
                <a class="text-link" href={l.url} target="_blank" rel="noopener">{l.label ?? l.url.replace(/^https?:\/\/(www\.)?/, '')}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="back"><a class="text-link" href={withBase('/film/')}><T t={UI.allFilms} /></a></p>
  </article>
  {stills.length > 0 && <Viewer items={viewerData(stills)} label={{ en, ko }} />}
</Base>

<style>
  .page--band {
    padding-top: clamp(32px, 4vw, 64px);
  }
  .draft {
    font: 500 13px/1.4 var(--f-nav);
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  .film__head {
    margin: 0 auto;
  }
  .film__still {
    aspect-ratio: 2.39;
    overflow: hidden;
  }
  .film__still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px 48px;
    margin: clamp(32px, 4vw, 52px) 0 clamp(56px, 8vw, 110px);
  }
  .film__title {
    font: 400 clamp(36px, 4.6vw, 64px) / 1.04 var(--f-display);
  }
  .film__intro--solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .film__intro--solo .film__title--alt {
    display: none;
  }
  .film__alt {
    display: block;
    margin-top: 10px;
    font: 400 18px/1.4 var(--f-ui);
    color: var(--ink-2);
  }
  .film__facts {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 10px;
  }
  .film__log {
    font-size: 18px;
    line-height: 1.5;
    max-width: 46ch;
  }
  .film__sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 12px 48px;
    padding: 28px 0 clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--line);
  }
  .film__sec--wide {
    grid-template-columns: 1fr;
  }
  .film__syn {
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.7;
  }
  .film__syn :global(p + p) {
    margin-top: 1em;
  }
  .stills {
    --H: clamp(150px, 17vw, 260px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(20px, 2.6vw, 40px);
  }
  .stills::after {
    content: '';
    flex: 999 1 0;
  }
  .stills li {
    flex: calc(var(--a) * var(--s)) 1 calc(var(--a) * var(--s) * var(--H));
    max-width: min(100%, calc(var(--nw) * 1.5px));
  }
  .stills a {
    display: block;
    cursor: zoom-in;
  }
  .stills img {
    width: 100%;
    aspect-ratio: var(--a);
  }
  .credits {
    display: grid;
    gap: 14px;
  }
  .credits div {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) 2fr;
    gap: 16px;
  }
  .credits dt {
    color: var(--ink-2);
  }
  .credits dd {
    display: grid;
  }
  .fest {
    display: grid;
    gap: 10px;
  }
  .fest li {
    display: grid;
    grid-template-columns: 5ch 1fr;
    gap: 16px;
  }
  .fest__y {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .links {
    display: grid;
    gap: 8px;
  }
  .back {
    margin-top: 24px;
    font: 500 14px/1 var(--f-nav);
  }
  @media (max-width: 760px) {
    .film__intro,
    .film__sec {
      grid-template-columns: minmax(0, 1fr);
    }
    .film__facts {
      padding-top: 0;
    }
    .stills {
      display: grid;
    }
    .stills::after {
      display: none;
    }
    .credits div {
      grid-template-columns: 1fr 1.6fr;
    }
  }
</style>
