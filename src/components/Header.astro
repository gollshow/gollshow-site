---
/**
 * goll · the reels · 소개 — English/한국어 — 소리 켜기.
 * The current page is lit in tungsten; everything else is ash.
 */
import T from './T.astro';
import { UI } from '../lib/i18n';
import { getRooms } from '../lib/works';
import { withBase } from '../lib/media';

interface Props { current?: string }
const { current } = Astro.props;
const rooms = await getRooms();
const nav = [...rooms.map((r) => ({ key: r.key, href: r.path, ko: r.ko, en: r.en })), { key: 'about', href: '/about/', ...UI.about }];
---
<header class="hd" data-header>
  <a class="hd__mark" href={withBase('/')} aria-label="goll — 벽 / the wall">goll</a>
  <nav class="hd__nav" aria-label="Reels">
    <ul>
      {nav.map((n) => (
        <li><a class="ui" href={withBase(n.href)} aria-current={current === n.key ? 'page' : undefined}><T ko={n.ko} en={n.en} /></a></li>
      ))}
    </ul>
  </nav>
  <div class="hd__tools">
    <button class="ui hd__btn" type="button" data-lang-toggle>
      <span class="t" lang="ko" aria-label="Switch to English">English</span><span class="t" lang="en" aria-label="한국어로 보기">한국어</span>
    </button>
    <button class="ui hd__btn hd__sound" type="button" data-sound-toggle aria-pressed="false">
      <i class="hd__lamp" aria-hidden="true"></i>
      <span class="hd__off"><T t={UI.soundOn} /></span><span class="hd__on"><T t={UI.soundOff} /></span>
    </button>
    <button class="ui hd__btn hd__menu" type="button" data-menu-open aria-expanded="false" aria-controls="menu"><T t={UI.menu} /></button>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__top">
    <a class="hd__mark" href={withBase('/')}>goll</a>
    <button class="ui hd__btn" type="button" data-menu-close><T t={UI.close} /></button>
  </div>
  <nav aria-label="Menu">
    <ul class="menu__list">
      <li><a href={withBase('/')} aria-current={current === 'wall' ? 'page' : undefined}><T t={UI.wall} /></a></li>
      {nav.map((n) => (
        <li><a href={withBase(n.href)} aria-current={current === n.key ? 'page' : undefined}><T ko={n.ko} en={n.en} /></a></li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .hd {
    position: fixed; inset: 0 0 auto 0; z-index: 40;
    height: var(--header-h);
    display: flex; align-items: center; gap: clamp(16px, 2.4vw, 40px);
    padding: 0 var(--margin);
    padding-top: env(safe-area-inset-top);
    pointer-events: none;
  }
  .hd > * { pointer-events: auto; }
  .hd::before { content: ''; position: absolute; inset: 0 0 -24px 0; z-index: -1; background: linear-gradient(#000 calc(100% - 24px), rgb(0 0 0 / 0)); pointer-events: none; }
  :global(.p-wall) .hd::before { display: none; }
  .hd__mark { font-size: 1.5rem; font-weight: 400; letter-spacing: -0.01em; line-height: 1; padding: 10px 0; margin-right: auto; color: var(--screen); }
  .hd__nav ul { display: flex; gap: clamp(14px, 1.9vw, 30px); }
  .hd__nav a { display: inline-block; padding: 10px 0; color: var(--ash); transition: color 160ms; }
  .hd__nav a:hover, .hd__nav a[aria-current='page'] { color: var(--beam); }
  .hd__tools { display: flex; align-items: center; gap: clamp(8px, 1.4vw, 22px); }
  .hd__btn { min-height: 44px; padding: 0 2px; color: var(--ash); transition: color 160ms; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
  .hd__btn:hover { color: var(--screen); }
  .hd__lamp { width: 7px; height: 7px; border-radius: 50%; border: 1px solid currentColor; transition: background 160ms, box-shadow 160ms; }
  .hd__sound[aria-pressed='true'] { color: var(--beam); }
  .hd__sound[aria-pressed='true'] .hd__lamp { background: var(--beam); box-shadow: 0 0 8px 1px rgb(246 231 200 / 0.6); }
  .hd__on { display: none; }
  .hd__sound[aria-pressed='true'] .hd__on { display: inline; }
  .hd__sound[aria-pressed='true'] .hd__off { display: none; }
  .hd__menu { display: none; }

  @media (max-width: 1023px) {
    .hd__nav { display: none; }
    .hd__menu { display: inline-flex; }
  }
  @media (max-width: 420px) {
    .hd__tools { gap: 12px; }
    .hd__lang-long { display: none; }
  }

  .menu {
    position: fixed; inset: 0; z-index: 60;
    background: var(--black);
    overflow-y: auto;
    padding: 0 var(--margin) calc(32px + env(safe-area-inset-bottom));
    display: flex; flex-direction: column;
  }
  .menu__top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; padding-top: env(safe-area-inset-top); }
  .menu__list { margin-top: clamp(24px, 7vh, 72px); display: grid; gap: 2px; }
  .menu__list a { display: block; padding: 6px 0; font-size: clamp(2rem, 9.5vw, 3.25rem); font-weight: 200; line-height: 1.15; letter-spacing: -0.02em; color: var(--ash); }
  .menu__list a:hover, .menu__list a[aria-current='page'] { color: var(--beam); }
</style>
