---
import Art from './Art.astro';
import T from './T.astro';
import { UI } from '../lib/i18n';
import { pad, type getRooms } from '../lib/works';
import { withBase } from '../lib/media';
interface Props { rooms: Awaited<ReturnType<typeof getRooms>>; heading?: boolean }
const { rooms: roomsShown, heading = true } = Astro.props;
---
  <section class="rooms frame" aria-labelledby="rooms-h">
    {heading && <h2 id="rooms-h" class="label muted rooms__h" data-reveal><T t={UI.rooms} /></h2>}
    <ol class="rooms__list">
      {roomsShown.map((r, i) => {
        const cover = r.works.find((w) => w.cover)?.cover;
        return (
          <li class="rooms__item" data-reveal style={`--i:${i}`}>
            <a class="rooms__link" href={withBase(r.path)}>
              <span class="rooms__no label">{pad(r.no)}</span>
              <span class="rooms__name"><span class="rooms__ko serif">{r.ko}</span><span class="rooms__en label">{r.en}</span></span>
              <span class="rooms__count label muted">{r.works.length ? <T ko={`${r.works.length}${r.unit.ko}`} en={`${r.works.length} ${r.unit.en}`} /> : '—'}</span>
              <span class="rooms__thumb" aria-hidden="true">{cover && <Art media={cover} alt="" sizes="120px" max={480} />}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

<style>
  /* ── Rooms ────────────────────────────────────────────────── */
  .rooms { padding-top: calc(var(--room-gap) * 0.5); }
  .rooms__h { padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .rooms__item { border-bottom: 1px solid var(--line); }
  .rooms__link { display: grid; grid-template-columns: 3.2em 1fr auto 64px; align-items: center; gap: 16px; min-height: 96px; padding: 14px 0; }
  .rooms__no { color: var(--ink-3); }
  .rooms__name { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 20px; }
  .rooms__ko { font-size: var(--t-h2); font-weight: 300; line-height: 1.1; transition: transform var(--d-mid) var(--ease-out); }
  .rooms__en { color: var(--ink-2); }
  .rooms__count { min-width: 5em; text-align: right; }
  .rooms__thumb { width: 64px; height: 64px; display: grid; place-items: center; }
  .rooms__thumb :global(.art) { width: 100%; max-height: 64px; aspect-ratio: var(--ratio); }
  .rooms__thumb :global(.art) { max-width: 64px; width: auto; height: 64px; }
  .rooms__link:hover .rooms__ko { transform: translateX(10px); }
  @media (min-width: 1024px) {
    .rooms__link { grid-template-columns: 1fr 4fr 1.2fr 1fr; min-height: 132px; }
    .rooms__thumb { width: auto; height: 88px; justify-self: end; }
    .rooms__thumb :global(.art) { height: 88px; max-width: 120px; }
  }

</style>
