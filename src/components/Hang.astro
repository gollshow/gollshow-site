---
/** A room's works, hung (curated rhythm) or as an index (contact sheet). */
import Art from './Art.astro';
import T from './T.astro';
import { hang } from '../lib/hang';
import { pad, type Work } from '../lib/works';
import { withBase } from '../lib/media';

interface Props { works: Work[]; room?: boolean; numbered?: boolean; mode?: 'hang' | 'index' }
const { works, room = false, numbered = true, mode = 'hang' } = Astro.props;
const slots = hang(works.map((w) => w.ratio));
---
<ol class="hg frame" data-mode={mode} {...(room ? { 'data-room': '' } : {})}>
  {works.map((w, i) => {
    const s = slots[i];
    const sizes = `(min-width: 1024px) ${Math.round((s.dSpan / 12) * 92)}vw, (min-width: 640px) ${Math.round((s.tSpan / 8) * 92)}vw, ${s.mW}vw`;
    const meta = [w.data.year, w.data.medium].filter(Boolean).join(' · ');
    const metaEn = [w.data.year, w.data.medium_en ?? w.data.medium].filter(Boolean).join(' · ');
    return (
      <li
        class:list={['hg__item', `hg__item--${s.kind}`, w.ratio >= 1 ? 'is-land' : 'is-port']}
        style={`--row:${s.row + 1};--ds:${s.dStart};--dn:${s.dSpan};--ts:${s.tStart};--tn:${s.tSpan};--shift:${s.dShift};--mw:${s.mW}%;--ma:${s.mAlign}`}
        data-reveal
      >
        <a class="hg__link" href={withBase(w.href)}>
          <span class="hg__frame">
            <Art media={w.cover} alt={w.data.title_en ? `${w.data.title} (${w.data.title_en})` : w.data.title} sizes={sizes} vt={`work-${w.slug}`} />
          </span>
          <span class="hg__cap">
            {numbered && <span class="hg__no label tnum">{pad(w.no)}</span>}
            <span class="hg__title serif"><T ko={w.data.title} en={w.data.title_en} /></span>
            {meta && <span class="hg__meta cap"><T ko={meta} en={metaEn} /></span>}
          </span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .hg { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gutter); row-gap: clamp(72px, 13vh, 168px); align-items: start; }
  .hg__item { min-width: 0; }
  .hg__link { display: block; }
  .hg__frame { display: block; }
  .hg__cap { display: grid; grid-template-columns: auto 1fr; column-gap: 14px; row-gap: 2px; margin-top: 14px; align-items: baseline; }
  .hg__no { color: var(--ink-3); grid-row: span 2; padding-top: 0.2em; }
  .hg__title { font-size: 1.0625rem; line-height: 1.45; background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px; transition: background-size var(--d-mid) var(--ease-out); justify-self: start; }
  .hg__meta { color: var(--ink-2); }
  .hg__link:hover .hg__title, .hg__link:focus-visible .hg__title { background-size: 100% 1px; }
  .hg__link :global(.art) { transition: opacity var(--d-mid); }
  .hg__link:hover :global(.art) { opacity: 0.94; }

  /* hang — mobile */
  .hg[data-mode='hang'] .hg__item { grid-column: 1 / -1; width: var(--mw); justify-self: var(--ma); }
  @media (min-width: 640px) {
    .hg[data-mode='hang'] .hg__item { grid-column: var(--ts) / span var(--tn); width: auto; justify-self: stretch; grid-row: var(--row); }
    .hg[data-mode='hang'] .hg__item { margin-top: calc(var(--shift) * clamp(16px, 3.4vw, 56px)); }
  }
  @media (min-width: 1024px) {
    .hg[data-mode='hang'] .hg__item { grid-column: var(--ds) / span var(--dn); }
    .hg[data-mode='hang'] .hg__item--pause { padding-block: clamp(24px, 6vh, 72px); }
  }

  /* index — contact sheet */
  .hg[data-mode='index'] { grid-template-columns: repeat(auto-fill, minmax(clamp(132px, 15vw, 210px), 1fr)); row-gap: 36px; }
  .hg[data-mode='index'] .hg__item { grid-column: auto; grid-row: auto; width: auto; margin: 0 !important; padding: 0 !important; justify-self: stretch; }
  .hg[data-mode='index'] .hg__frame { aspect-ratio: 1; display: grid; place-items: center; background: var(--paper-2); }
  .hg[data-mode='index'] .is-land .hg__frame :global(.art) { width: 78%; }
  .hg[data-mode='index'] .is-port .hg__frame :global(.art) { height: 78%; width: auto; }
  .hg[data-mode='index'] .hg__cap { margin-top: 10px; column-gap: 10px; }
  .hg[data-mode='index'] .hg__title { font-size: 0.9375rem; }
  .hg[data-mode='index'] .hg__meta { font-size: 0.75rem; }
</style>
