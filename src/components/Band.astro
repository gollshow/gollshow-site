---
/**
 * The head of every inner page: a still watercolour shape in the site's four pigments
 * (each page its own shape and seed, src/scripts/band.ts), with the page's name in ink.
 * Both fade in calmly. The slot holds a short line under it.
 */
import T from './T.astro';
import { getSettings } from '../lib/site';

interface Props {
  en: string;
  ko?: string;
  seed?: number;
  shape?: 'stroke' | 'pool' | 'diagonal' | 'veil' | 'ring' | 'pour';
  short?: boolean;
  pigments?: string[]; // the room's own colours; default: the four set in /admin
}
const { en, ko = en, seed = 0, shape = 'stroke', short = false } = Astro.props;
const s = await getSettings();
const p = s.pigments;
const pig = Astro.props.pigments?.length === 4 ? Astro.props.pigments : [p.ultramarine, p.vermilion, p.viridian, p.ochre];
---
<section
  class:list={['band', `band--${shape}`, { 'band--short': short }]}
  data-band
  data-seed={seed}
  data-shape={shape}
  data-pigments={pig.join(',')}
  style={`--p0:${pig[0]};--p1:${pig[1]};--p2:${pig[2]};--p3:${pig[3]}`}
>
  <canvas class="band__cv" aria-hidden="true"></canvas>
  <div class="band__wash" aria-hidden="true"></div>
  <h1 class="band__word"><T en={en} ko={ko} /></h1>
</section>
{
  Astro.slots.has('default') && (
    <div class="band__after">
      <slot />
    </div>
  )
}

<script>
  import '../scripts/band';
</script>

<style>
  .band {
    position: relative;
    height: clamp(300px, 50vh, 560px);
    overflow: hidden;
  }
  .band--short {
    height: clamp(230px, 36vh, 400px);
  }
  .band__cv {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1600ms ease;
  }
  .band.is-gl .band__cv {
    opacity: 1;
  }
  /* Static version (no JS / no WebGL) */
  .band__wash {
    position: absolute;
    left: 30%;
    right: -6%;
    top: 14%;
    bottom: 10%;
    background:
      radial-gradient(40% 70% at 30% 50%, color-mix(in srgb, var(--p0) 60%, transparent), transparent 72%),
      radial-gradient(34% 80% at 56% 56%, color-mix(in srgb, var(--p2) 55%, transparent), transparent 72%),
      radial-gradient(30% 70% at 76% 44%, color-mix(in srgb, var(--p1) 55%, transparent), transparent 72%),
      radial-gradient(26% 60% at 92% 60%, color-mix(in srgb, var(--p3) 60%, transparent), transparent 70%);
    filter: blur(36px);
    opacity: 0.55;
    display: none;
  }
  .band.is-static .band__wash,
  :global(html:not(.js)) .band__wash {
    display: block;
  }
  .band__word {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 72%;
    display: flex;
    align-items: flex-end;
    padding: 0 var(--gutter);
    font: 400 min(24vh, 13.5vw) / 0.8 var(--f-display);
    letter-spacing: -0.012em;
    color: var(--ink);
    white-space: nowrap;
  }
  :global(html[data-lang='ko']) .band__word {
    font-size: min(18vh, 11vw);
    letter-spacing: -0.01em;
  }
  .band--short .band__word {
    font-size: min(17vh, 12vw);
  }
  @media (prefers-reduced-motion: no-preference) {
    .band__word {
      animation: band-word 1200ms cubic-bezier(0.2, 0.7, 0.2, 1) 200ms both;
    }
  }
  @keyframes band-word {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .band__cv {
      transition: none;
    }
  }
  .band__after {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 6px var(--gutter) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    align-items: baseline;
    font: 400 14px/1.5 var(--f-nav);
    color: var(--ink-2);
  }
  @media (max-width: 700px) {
    .band,
    .band--short {
      height: clamp(200px, 30vh, 280px);
    }
    .band__word,
    .band--short .band__word {
      font-size: min(15vw, 22vh);
    }
  }
</style>
