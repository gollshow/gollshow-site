---
/** Click-to-load embed (keeps third-party players off the page until wanted). */
import T from './T.astro';
import { embedFor } from '../lib/embed';
import { UI } from '../lib/i18n';
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const e = embedFor(url);
const host = (() => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return url; } })();
---
{e ? (
  <div class="em" style={`--ar:${e.ratio}`} data-embed={e.src} data-embed-title={title}>
    <button type="button" class="em__play">
      <span class="em__icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4.5 2.8v10.4L13 8z" fill="currentColor" /></svg></span>
      <span class="label"><T t={e.kind === 'soundcloud' ? UI.listen : UI.watch} /></span>
      <span class="cap">{e.kind === 'soundcloud' ? 'SoundCloud' : e.kind === 'vimeo' ? 'Vimeo' : 'YouTube'}</span>
    </button>
  </div>
) : (
  <a class="btn" href={url} target="_blank" rel="noopener"><T t={UI.listen} /> — {host} ↗</a>
)}
<style>
  .em { position: relative; aspect-ratio: var(--ar); width: 100%; background: var(--paper-2); }
  .em :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .em__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 14px; color: var(--ink); transition: background var(--d-fast); }
  .em__play:hover { background: var(--line); }
  .em__icon { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--paper); }
  .em__icon svg { width: 16px; height: 16px; margin-left: 2px; }
</style>
