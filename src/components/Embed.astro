---
/** Click-to-load embed for YouTube / Vimeo / SoundCloud links (keeps third-party players off the page until wanted). */
import T from './T.astro';
import { embedFor } from '../lib/embed';
import { UI } from '../lib/i18n';
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const e = embedFor(url);
const host = (() => { try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return url; } })();
---
{e ? (
  <div class="em" style={`--ar:${e.ratio}`} data-embed={e.src} data-embed-title={title}>
    <button type="button" class="em__play ui"><T t={UI.play} /><span class="ash">{e.kind === 'soundcloud' ? 'SoundCloud' : e.kind === 'vimeo' ? 'Vimeo' : 'YouTube'}</span></button>
  </div>
) : (
  <a class="em__link ui" href={url} target="_blank" rel="noopener">{host}<span class="sr-only"> (<T t={UI.newWindow} />)</span></a>
)}
<script>
  document.addEventListener('click', (e) => {
    const box = (e.target as Element).closest<HTMLElement>('[data-embed]');
    if (!box || box.querySelector('iframe')) return;
    const f = document.createElement('iframe');
    f.src = box.dataset.embed!;
    f.title = box.dataset.embedTitle || 'Player';
    f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
    f.allowFullscreen = true;
    box.replaceChildren(f);
  });
</script>
<style>
  .em { position: relative; aspect-ratio: var(--ar); width: 100%; background: #0b0a09; }
  .em :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .em__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 14px; color: var(--beam); }
  .em__link { color: var(--beam); border-bottom: 1px solid var(--dust); }
</style>
