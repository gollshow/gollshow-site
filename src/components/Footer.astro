---
import Kong from './Kong.astro';
import T from './T.astro';
import { UI } from '../lib/i18n';
import { getSettings } from '../lib/works';
import { withBase } from '../lib/media';

const s = await getSettings();
const handle = s.instagram?.match(/instagram\.com\/([^/?#]+)/)?.[1];
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="frame ft__in">
    <a class="ft__kong" href={withBase('/')} aria-label="空 — home"><Kong /></a>
    <div class="ft__col">
      <p class="label muted"><T t={UI.contact} /></p>
      <ul class="ft__links">
        {s.email && <li><a class="link" href={`mailto:${s.email}`}>{s.email}</a></li>}
        {s.instagram && <li><a class="link" href={s.instagram} target="_blank" rel="me noopener">Instagram{handle && <span class="muted"> @{handle}</span>}</a></li>}
        {s.links.map((l) => <li><a class="link" href={l.url} target="_blank" rel="me noopener">{l.label ?? l.url}</a></li>)}
      </ul>
    </div>
    <p class="ft__copy cap">© {year} goll{s.name_en && ` · ${s.name_en}`}</p>
  </div>
</footer>

<style>
  .ft { margin-top: var(--room-gap); padding: 48px 0 calc(40px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); }
  .ft__in { display: grid; grid-template-columns: auto 1fr; gap: 28px 40px; align-items: start; }
  .ft__kong { width: 44px; color: var(--ink); opacity: 0.9; transition: opacity var(--d-fast); }
  .ft__kong:hover { opacity: 0.6; }
  .ft__col .label { margin-bottom: 10px; }
  .ft__links { display: flex; flex-wrap: wrap; gap: 6px 28px; font-size: var(--t-cap); }
  .ft__links a { display: inline-block; padding: 6px 0; }
  .ft__copy { grid-column: 1 / -1; color: var(--ink-3); }
  @media (min-width: 900px) {
    .ft__in { grid-template-columns: 1fr 2fr auto; align-items: end; }
    .ft__copy { grid-column: auto; }
  }
</style>
