---
/**
 * The mini-player for uploaded tracks. It survives page navigation
 * (transition:persist), so music keeps playing while you walk along the wall.
 * Hidden until a track is played. Its edge is a strip of optical soundtrack.
 */
import T from './T.astro';
import { UI } from '../lib/i18n';
---
<div class="pl" data-player transition:persist="player" hidden>
  <canvas class="pl__track" data-player-track aria-hidden="true"></canvas>
  <button class="pl__toggle ui" type="button" data-player-toggle>
    <span class="pl__play"><T t={UI.play} /></span><span class="pl__pause"><T t={UI.pause} /></span>
  </button>
  <a class="pl__title" data-player-title href="#"></a>
  <span class="pl__time count small" data-player-time aria-live="off">0:00</span>
  <button class="pl__close ui" type="button" data-player-close><T t={UI.close} /></button>
  <audio data-player-audio preload="none"></audio>
</div>

<style>
  .pl {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
    display: flex; align-items: center; gap: 16px;
    padding: 0 var(--margin) env(safe-area-inset-bottom);
    height: calc(52px + env(safe-area-inset-bottom));
    background: var(--black);
    border-top: 1px solid #1d1a16;
  }
  .pl__track { position: absolute; left: 0; right: 0; top: -9px; width: 100%; height: 8px; }
  .pl__toggle, .pl__close { min-height: 44px; color: var(--ash); }
  .pl__toggle { color: var(--beam); }
  .pl__pause { display: none; }
  .pl.is-playing .pl__pause { display: inline; }
  .pl.is-playing .pl__play { display: none; }
  .pl__title { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl__time { color: var(--ash); }
  .pl__close:hover, .pl__title:hover { color: var(--beam); }
</style>
