---
/**
 * Full-screen viewer on the same ground. Opened by any link with [data-view="<index>"]
 * inside the page; the items come from the JSON written here. ←/→, swipe, Esc, a
 * close button, focus kept inside (modal dialog), a counter "12 / 63", and a
 * "Process" button when the work has a process video.
 */
import T from './T.astro';
import { UI } from '../lib/site';
import type { ViewerItem } from '../lib/art';

interface Props {
  items: ViewerItem[];
  label: { en: string; ko: string };
}
const { items, label } = Astro.props;
---
<dialog class="viewer" aria-label={label.en} data-aria-en={label.en} data-aria-ko={label.ko}>
  <script type="application/json" class="viewer__data" set:html={JSON.stringify(items).replace(/</g, '\\u003c')} />
  <button class="tbtn viewer__close" type="button" data-close autofocus><T t={UI.close} /></button>
  <div class="viewer__stage">
    <figure class="viewer__fig">
      <img class="viewer__img" alt="" decoding="async" />
    </figure>
    <div class="viewer__video" hidden></div>
    <button class="viewer__zone viewer__zone--prev" type="button" tabindex="-1" aria-hidden="true" data-prev></button>
    <button class="viewer__zone viewer__zone--next" type="button" tabindex="-1" aria-hidden="true" data-next></button>
  </div>
  <div class="viewer__bar">
    <div class="viewer__cap" aria-live="polite"></div>
    <div class="viewer__ctl">
      <button class="tbtn viewer__process" type="button" data-process hidden>
        <span class="viewer__process-a"><T t={UI.process} /></span><span class="viewer__process-b" hidden><T t={UI.work} /></span>
      </button>
      <button class="tbtn" type="button" data-prev><T t={UI.prev} /></button>
      <button class="tbtn" type="button" data-next><T t={UI.next} /></button>
      <span class="viewer__count" aria-hidden="true"></span>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/viewer';
</script>

<style>
  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ground);
    color: var(--ink);
    overflow: hidden;
  }
  .viewer[open] {
    display: grid;
    grid-template-rows: var(--top-h) 1fr auto;
    animation: viewer-in 220ms ease both;
  }
  .viewer::backdrop {
    background: var(--ground);
  }
  @keyframes viewer-in {
    from {
      opacity: 0;
    }
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
  .viewer__close {
    grid-row: 1;
    justify-self: end;
    align-self: center;
    margin-right: 24px;
  }
  .viewer__stage {
    grid-row: 2;
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 var(--gutter);
    touch-action: pan-y pinch-zoom;
  }
  .viewer__fig,
  .viewer__video {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
  }
  .viewer__img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* Ink-bleed reveal: the image appears through a noise-threshold mask (16 frames). */
  .viewer__fig.is-wait {
    opacity: 0;
  }
  .viewer__fig.is-bleed {
    -webkit-mask-image: var(--wash);
    mask-image: var(--wash);
    -webkit-mask-size: 1600% 100%;
    mask-size: 1600% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: bleed 700ms steps(16, jump-none) both;
  }
  @keyframes bleed {
    from {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
    to {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .viewer[open] {
      animation: none;
    }
    .viewer__fig {
      transition: opacity 260ms ease;
    }
    .viewer__fig.is-bleed {
      -webkit-mask-image: none;
      mask-image: none;
      animation: none;
    }
  }
  .viewer__video :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .viewer__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 0;
    cursor: w-resize;
  }
  .viewer__zone--prev {
    left: 0;
  }
  .viewer__zone--next {
    right: 0;
    cursor: e-resize;
  }
  .viewer__bar {
    grid-row: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 16px var(--gutter) 22px;
    min-height: 84px;
  }
  .viewer__cap {
    font: 400 14px/1.5 var(--f-ui);
    max-width: 62ch;
    padding-bottom: 6px;
  }
  .viewer__cap :global(.viewer__title) {
    font: 400 22px/1.2 var(--f-display);
    margin-bottom: 4px;
  }
  .viewer__cap :global(.viewer__meta) {
    color: var(--ink-2);
  }
  .viewer__ctl {
    display: flex;
    align-items: center;
    gap: 6px 18px;
    flex-shrink: 0;
  }
  .viewer__count {
    font: 400 14px/1 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    min-width: 5.5ch;
    text-align: right;
  }
  .viewer__process {
    margin-right: 10px;
  }
  @media (max-width: 640px) {
    .viewer__close {
      margin-right: 12px;
    }
    .viewer__bar {
      flex-direction: column;
      align-items: stretch;
      padding: 10px 16px calc(14px + env(safe-area-inset-bottom));
    }
    .viewer__ctl {
      justify-content: space-between;
      gap: 4px;
    }
    .viewer__process {
      margin-right: auto;
    }
    .viewer__cap :global(.viewer__title) {
      font-size: 20px;
    }
  }
</style>
