---
/**
 * The projection: a work thrown large on the screen, with film grain, gentle
 * gate weave, halation and a soft vignette. ← → / swipe / 이전 다음 advance
 * like a reel: a hard splice cut with a single-frame flash. Esc closes.
 */
import T from './T.astro';
import { UI } from '../lib/i18n';
---
<dialog class="pj" data-viewer aria-label="Projection">
  <div class="pj__screen" data-pj-stage tabindex="-1" autofocus>
    <div class="pj__weave">
      <picture class="pj__halo" aria-hidden="true"><img data-pj-halo alt="" /></picture>
      <picture class="pj__pic">
        <source type="image/avif" data-pj-avif sizes="92vw" />
        <source type="image/webp" data-pj-webp sizes="92vw" />
        <img data-pj-img alt="" draggable="false" />
      </picture>
    </div>
    <div class="pj__vignette" aria-hidden="true"></div>
    <div class="pj__grainbox" aria-hidden="true"><div class="grain"></div></div>
    <div class="pj__flash" data-pj-flash aria-hidden="true"><i></i></div>
  </div>
  <p class="pj__count count" data-pj-count aria-live="polite"></p>
  <button class="pj__btn pj__close ui" type="button" data-pj-close><T t={UI.close} /></button>
  <button class="pj__btn pj__prev ui" type="button" data-pj-prev><T t={UI.prev} /></button>
  <button class="pj__btn pj__next ui" type="button" data-pj-next><T t={UI.next} /></button>
  <div class="pj__cap" data-pj-cap></div>
  <a class="pj__more ui" data-pj-more href="#" hidden><T t={UI.process} /></a>
</dialog>

<style>
  .pj {
    position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--black); color: var(--screen);
    overflow: hidden; overscroll-behavior: contain;
  }
  .pj::backdrop { background: var(--black); }
  .pj__screen:focus { outline: none; }
  .pj__screen { position: absolute; inset: 0; display: grid; place-items: center; touch-action: pan-y; user-select: none; -webkit-user-select: none; overflow: hidden; }
  .pj__weave { position: relative; display: grid; place-items: center; animation: weave 0.5s steps(1) infinite; }
  .pj__weave > * { grid-area: 1 / 1; }
  .pj__pic img, .pj__halo img {
    display: block;
    max-width: calc(100vw - 2 * var(--margin));
    max-height: calc(100dvh - 2 * clamp(72px, 13vh, 132px));
    width: auto; height: auto;
    object-fit: contain;
  }
  .pj__pic img { background-size: cover; }
  /* halation: highlights bloom warm into the dark around them */
  .pj__halo { filter: blur(22px) saturate(1.6) sepia(0.35); opacity: 0.4; mix-blend-mode: screen; transform: scale(1.03); pointer-events: none; }
  .pj__vignette { position: absolute; inset: 0; background: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 55%, rgb(0 0 0 / 0.55) 100%); pointer-events: none; }
  .pj__grainbox { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .pj__grainbox .grain { opacity: 0.16; }
  .pj__flash { position: absolute; inset: 0; pointer-events: none; opacity: 0; background: var(--beam); }
  .pj__flash i { position: absolute; left: 0; right: 0; top: var(--splice, 38%); height: 2px; background: rgb(255 255 255 / 0.8); }
  .pj__flash.is-on { opacity: 0.28; }

  .pj__count { position: absolute; left: var(--margin); top: calc(14px + env(safe-area-inset-top)); color: var(--ash); line-height: 44px; }
  .pj__btn { position: absolute; min-height: 44px; min-width: 44px; padding: 0 4px; color: var(--ash); transition: color 160ms; }
  .pj__btn:hover { color: var(--beam); }
  .pj__close { right: var(--margin); top: calc(14px + env(safe-area-inset-top)); }
  .pj__prev, .pj__next { top: 50%; transform: translateY(-50%); }
  .pj__prev { left: var(--margin); }
  .pj__next { right: var(--margin); }
  .pj__cap { position: absolute; left: var(--margin); right: var(--margin); bottom: calc(18px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 0; pointer-events: none; }
  .pj__cap :global(.c-frame) { display: none; }
  .pj__cap :global(.c-room) { color: var(--ash); }
  .pj__cap :global(.c-title) { font-size: var(--t-head); font-weight: 200; line-height: 1.2; }
  .pj__cap :global(.c-year), .pj__cap :global(.c-sm) { color: var(--ash); }
  .pj__more { position: absolute; right: var(--margin); bottom: calc(18px + env(safe-area-inset-bottom)); color: var(--ash); min-height: 44px; display: inline-flex; align-items: center; border-bottom: 1px solid var(--dust); }
  .pj__more:hover { color: var(--beam); }

  @media (max-width: 760px) {
    .pj__prev, .pj__next { top: auto; bottom: calc(10px + env(safe-area-inset-bottom)); transform: none; }
    .pj__prev { left: auto; right: calc(var(--margin) + 64px); }
    .pj__cap { right: calc(var(--margin) + 130px); }
    .pj__more { bottom: auto; top: calc(14px + env(safe-area-inset-top)); right: calc(var(--margin) + 64px); border: 0; }
  }
  @media (hover: none) and (max-width: 760px) {
    .pj__prev, .pj__next { display: none; }
    .pj__cap { right: var(--margin); }
  }
</style>
