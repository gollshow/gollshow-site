---
/**
 * Full-screen viewer on the same ground. Opened by any link with [data-view="<index>"]
 * inside the page (or a "view-open" event); the items come from the JSON written here.
 * The first screen holds the whole work, coming into focus, with its caption, ←/→,
 * swipe, Esc, a close button, a counter "12 / 63" and a "Process" button when the work
 * has a process video. When the work has detail cuts they follow below: scroll down.
 * Focus is kept inside (modal dialog).
 */
import T from './T.astro';
import { UI } from '../lib/site';
import type { ViewerItem } from '../lib/art';

interface Props {
  items: ViewerItem[];
  label: { en: string; ko: string };
}
const { items, label } = Astro.props;
---
<dialog class="viewer" aria-label={label.en} data-aria-en={label.en} data-aria-ko={label.ko}>
  <script type="application/json" class="viewer__data" set:html={JSON.stringify(items).replace(/</g, '\\u003c')} />
  <button class="tbtn viewer__close" type="button" data-close autofocus><T t={UI.close} /></button>
  <div class="viewer__first">
    <div class="viewer__stage">
      <figure class="viewer__fig">
        <img class="viewer__img" alt="" decoding="async" />
      </figure>
      <div class="viewer__video" hidden></div>
      <button class="viewer__zone viewer__zone--prev" type="button" tabindex="-1" aria-hidden="true" data-prev></button>
      <button class="viewer__zone viewer__zone--next" type="button" tabindex="-1" aria-hidden="true" data-next></button>
    </div>
    <div class="viewer__bar">
      <div class="viewer__cap" aria-live="polite"></div>
      <button class="viewer__more" type="button" hidden></button>
      <div class="viewer__ctl">
        <button class="tbtn viewer__process" type="button" data-process hidden>
          <span class="viewer__process-a"><T t={UI.process} /></span><span class="viewer__process-b" hidden><T t={UI.work} /></span>
        </button>
        <button class="tbtn" type="button" data-prev><T t={UI.prev} /></button>
        <button class="tbtn" type="button" data-next><T t={UI.next} /></button>
        <span class="viewer__count" aria-hidden="true"></span>
      </div>
    </div>
  </div>
  <div class="viewer__details" hidden></div>
</dialog>

<script>
  import '../scripts/viewer';
</script>

<style>
  .viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ground);
    color: var(--ink);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .viewer[open] {
    display: block;
    animation: viewer-in 220ms ease both;
  }
  .viewer::backdrop {
    background: var(--ground);
  }
  @keyframes viewer-in {
    from {
      opacity: 0;
    }
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
  .viewer__close {
    position: fixed;
    z-index: 3;
    top: calc((var(--top-h) - 40px) / 2);
    right: 24px;
  }
  /* the first screen: the whole work */
  .viewer__first {
    height: 100vh;
    height: 100svh;
    display: grid;
    grid-template-rows: var(--top-h) 1fr auto;
  }
  .viewer__stage {
    grid-row: 2;
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 var(--gutter);
    touch-action: pan-y pinch-zoom;
  }
  .viewer__fig,
  .viewer__video {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
  }
  .viewer__img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* the image comes into focus */
  .viewer__fig.is-wait {
    opacity: 0;
  }
  .viewer__fig.is-bleed {
    animation: v-in 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes v-in {
    from {
      opacity: 0;
      filter: blur(18px);
      transform: scale(0.985);
    }
  }
  .viewer__video :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .viewer__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 0;
    cursor: w-resize;
  }
  .viewer__zone--prev {
    left: 0;
  }
  .viewer__zone--next {
    right: 0;
    cursor: e-resize;
  }
  .viewer__bar {
    grid-row: 3;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 16px var(--gutter) 22px;
    min-height: 84px;
  }
  .viewer__cap {
    font: 400 14px/1.5 var(--f-ui);
    max-width: 62ch;
    padding-bottom: 6px;
  }
  .viewer__cap :global(.viewer__title) {
    font: 400 22px/1.2 var(--f-display);
    margin-bottom: 4px;
  }
  .viewer__cap :global(.viewer__meta) {
    color: var(--ink-2);
  }
  /* "2 details below": a quiet pointer to what follows */
  .viewer__more {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 8px;
    font: 400 13px/1 var(--f-nav);
    color: var(--ink-2);
    white-space: nowrap;
  }
  .viewer__more::after {
    content: '';
    width: 1px;
    height: 26px;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
  }
  .viewer__more:hover {
    color: var(--ink);
  }
  .viewer__ctl {
    display: flex;
    align-items: center;
    gap: 6px 18px;
    flex-shrink: 0;
  }
  .viewer__count {
    font: 400 14px/1 var(--f-nav);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    min-width: 5.5ch;
    text-align: right;
  }
  .viewer__process {
    margin-right: 10px;
  }
  /* the detail cuts, one under another */
  .viewer__details {
    display: grid;
    justify-items: center;
    gap: clamp(40px, 6vw, 96px);
    padding: clamp(24px, 4vw, 64px) var(--gutter) clamp(80px, 10vw, 160px);
  }
  .viewer__details :global(.viewer__det) {
    margin: 0;
    width: min(100%, 1100px);
    transition:
      opacity 1.3s ease,
      filter 1.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .viewer__details :global(.viewer__det:not(.is-in)) {
    opacity: 0;
    filter: blur(16px);
    transform: scale(1.015);
  }
  .viewer__details :global(.viewer__det img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .viewer[open],
    .viewer__fig.is-bleed {
      animation: none;
    }
    .viewer__fig {
      transition: opacity 260ms ease;
    }
    .viewer__details :global(.viewer__det) {
      transition: none;
    }
  }
  @media (max-width: 640px) {
    .viewer__close {
      right: 12px;
    }
    .viewer__bar {
      flex-direction: column;
      align-items: stretch;
      padding: 10px 16px calc(14px + env(safe-area-inset-bottom));
    }
    .viewer__more {
      position: static;
      transform: none;
      justify-self: start;
      justify-items: start;
      grid-auto-flow: column;
      align-items: center;
      padding: 4px 0;
    }
    .viewer__more::after {
      width: 26px;
      height: 1px;
    }
    .viewer__ctl {
      justify-content: space-between;
      gap: 4px;
    }
    .viewer__process {
      margin-right: auto;
    }
    .viewer__cap :global(.viewer__title) {
      font-size: 20px;
    }
  }
</style>
